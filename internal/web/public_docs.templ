package web

import "apimock/internal/domain"

type PublicDocsPayload struct {
	Workspace     domain.Workspace  `json:"workspace"`
	Endpoints     []domain.Endpoint `json:"endpoints"`
	PublicBaseURL string            `json:"public_base_url"`
}

templ PublicDocsPage(workspace domain.Workspace, endpoints []domain.Endpoint, publicBaseURL string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ workspace.Name } — Public API Docs &amp; Playground | Mocklab</title>
			<script>try { const value=localStorage.getItem('mocklab-theme'); document.documentElement.dataset.theme=value==='night'||!['light','night'].includes(value)&&matchMedia('(prefers-color-scheme: dark)').matches?'night':'light'; } catch { document.documentElement.dataset.theme='light'; }</script>
			<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
			<link rel="alternate icon" type="image/x-icon" href="/assets/favicon.ico"/>
			<link rel="stylesheet" href="/assets/app.css"/>
			@templ.JSONScript("public-docs-data", PublicDocsPayload{
				Workspace:     workspace,
				Endpoints:     endpoints,
				PublicBaseURL: publicBaseURL,
			})
			<script type="module" src="/assets/app.js"></script>
		</head>
		<body class="apidoc-body" x-data="publicDocs">
			<!-- Sticky Top API Documentation Header -->
			<header class="apidoc-topbar">
				<div class="apidoc-topbar-left">
					<a href={ templ.SafeURL("/share/" + workspace.Slug) } class="apidoc-brand">
						<span class="apidoc-brand-icon" aria-hidden="true">☁</span>
						<strong class="apidoc-brand-title" x-text="workspace.name">{ workspace.Name }</strong>
						<span class="apidoc-badge-ref">API Reference</span>
					</a>
					<span class="pub-live-pill">● LIVE MOCK</span>
				</div>

				<div class="apidoc-topbar-center">
					<div class="apidoc-server-pill" @click="copyBaseURL()" title="Click to copy API Base URL">
						<span class="apidoc-server-label">BASE URL</span>
						<code class="apidoc-server-url" x-text="baseURL"></code>
						<button type="button" class="apidoc-server-copy" @click.stop="copyBaseURL()" aria-label="Copy Base URL">
							@V2Icon("copy")
						</button>
					</div>
				</div>

				<div class="apidoc-topbar-right">
					<search class="apidoc-top-search" aria-label="Filter API endpoints">
						<input type="search" class="apidoc-search-input" placeholder="Search endpoints (e.g. /products)…" aria-label="Search endpoints" x-model="search"/>
					</search>
					<button type="button" class="apidoc-share-btn" @click="copyShareURL()" title="Copy public documentation link">
						@V2Icon("copy")
						<span>Share Docs</span>
					</button>
					<a href="https://github.com/kal72/apimock" target="_blank" rel="noopener noreferrer" class="v2-github-link" title="GitHub: kal72/apimock" aria-label="Mocklab on GitHub">
						@V2Icon("github")
					</a>
					@ThemeSwitch()
				</div>
			</header>

			<!-- Floating Toast Notification -->
			<div class="notice v2-toast" role="status" aria-live="polite" x-show="notice" x-cloak @click="notice = ''">
				<span class="v2-toast-dot" aria-hidden="true">✓</span>
				<span class="v2-toast-text" x-text="notice"></span>
				<button type="button" class="v2-toast-close" aria-label="Dismiss notification" @click.stop="notice = ''">✕</button>
			</div>

			<!-- Three-Pane Developer Reference Layout -->
			<div class="apidoc-layout">
				<!-- Left Pane: API Reference Table of Contents -->
				<aside class="apidoc-sidebar" aria-label="API Reference Navigation">
					<div class="apidoc-nav-group">
						<div class="apidoc-nav-heading">ON THIS PAGE</div>
						<a href="#apidoc-overview" class="apidoc-nav-link">
							<span class="apidoc-nav-dot"></span>
							<span>Request Parameters</span>
						</a>
						<a href="#apidoc-routing-spec" class="apidoc-nav-link" x-show="endpoint">
							<span class="apidoc-nav-dot"></span>
							<span>Responses</span>
						</a>
					</div>

					<div class="apidoc-nav-group apidoc-nav-endpoints">
						<div class="apidoc-nav-heading-row">
							<span class="apidoc-nav-heading">ENDPOINTS</span>
							<span class="sidebar-count" :class="(search.trim() || methodFilter !== 'ALL') && 'is-filtered'" x-text="(search.trim() || methodFilter !== 'ALL') ? filteredEndpoints.length + '/' + endpoints.length : endpoints.length"></span>
						</div>

						<div class="pub-method-filters" role="group" aria-label="Filter by HTTP method">
							<template x-for="m in ['ALL', 'GET', 'POST', 'PUT', 'PATCH', 'DELETE']" :key="m">
								<button type="button" class="pub-method-chip" :class="methodFilter === m && 'active'" @click="methodFilter = m" x-text="m"></button>
							</template>
						</div>

						<nav class="apidoc-toc-list" aria-label="Endpoints">
							<template x-for="e in filteredEndpoints" :key="e.id">
								<button type="button" class="apidoc-toc-item" :class="endpoint?.id === e.id && 'is-active'" @click="selectEndpoint(e)">
									<span class="method v2-method apidoc-toc-method" :class="[e.method.toLowerCase(), 'v2-' + e.method.toLowerCase()]" x-text="e.method"></span>
									<div class="apidoc-toc-text">
										<strong class="truncate" x-text="e.name"></strong>
										<code class="truncate" x-text="e.path"></code>
									</div>
								</button>
							</template>
							<p class="pub-empty-list" x-show="!filteredEndpoints.length">No endpoints match your filter.</p>
						</nav>
					</div>

					<div class="apidoc-sidebar-footer">
						<span>Powered by <strong>Mocklab</strong></span>
						<span>Public API Reference</span>
					</div>
				</aside>

				<!-- Empty Workspace State -->
				<template x-if="!endpoints.length">
					<main class="apidoc-empty">
						<div class="brand-symbol">⌘</div>
						<h1>No endpoints published yet</h1>
						<p>This workspace does not have any saved API endpoints yet.</p>
					</main>
				</template>

				<!-- Center & Right Panes when an Endpoint is Selected -->
				<template x-if="endpoint">
					<div class="apidoc-content-grid">
						<!-- Center Pane: Editorial API Reference Specification -->
						<main class="apidoc-article" id="public-docs-main">
							<div class="apidoc-article-inner">
								<!-- Endpoint Header & Full Callable Route -->
								<header id="apidoc-overview" class="apidoc-endpoint-header">
									<h1 class="apidoc-endpoint-title" x-text="endpoint.name"></h1>

									<div class="apidoc-route-banner">
										<span class="method v2-method apidoc-route-method" :class="[(endpoint?.method || 'GET').toLowerCase(), 'v2-' + (endpoint?.method || 'GET').toLowerCase()]" x-text="endpoint.method"></span>
										<code class="apidoc-route-url">
											<span class="apidoc-route-base" x-text="baseURL"></span><strong class="apidoc-route-path" x-text="endpoint.path"></strong>
										</code>
										<button type="button" class="apidoc-copy-pill" @click="copyEndpointURL()" aria-label="Copy endpoint URL">
											@V2Icon("copy")
											<span>Copy URL</span>
										</button>
									</div>
								</header>

								<!-- Section 1: Request Parameters, Headers & Body -->
								<section class="apidoc-section">
									<div class="apidoc-section-head">
										<h2>Request Parameters</h2>
										<p>Parameters, headers, and request body accepted by this endpoint.</p>
									</div>

									<!-- Path Parameters Dictionary -->
									<div class="apidoc-spec-group" x-show="routeParams.length">
										<h3 class="apidoc-group-title">Path parameters</h3>
										<div class="apidoc-prop-list">
											<template x-for="param in routeParams" :key="param">
												<div class="apidoc-prop-row">
													<div class="apidoc-prop-head">
														<code class="apidoc-prop-name" x-text="param"></code>
														<span class="apidoc-prop-type">string</span>
														<span class="apidoc-prop-req">Required</span>
													</div>
													<div class="apidoc-prop-desc">
														<span>Dynamic route segment </span>
														<code x-text="':' + param"></code>
														<span> · Example: </span>
														<code class="apidoc-prop-val" x-text="requestExample.params?.[param] || '123'"></code>
													</div>
												</div>
											</template>
										</div>
									</div>

									<!-- Query Parameters Dictionary -->
									<div class="apidoc-spec-group" x-show="documentedQueryParams.length">
										<h3 class="apidoc-group-title">Query parameters</h3>
										<div class="apidoc-prop-list">
											<template x-for="item in documentedQueryParams" :key="item.key">
												<div class="apidoc-prop-row">
													<div class="apidoc-prop-head">
														<code class="apidoc-prop-name" x-text="item.key"></code>
														<span class="apidoc-prop-type">string</span>
														<span class="apidoc-prop-opt">Optional</span>
													</div>
													<div class="apidoc-prop-desc">
														<span>Example value: </span>
														<code class="apidoc-prop-val" x-text="item.value || '(any)'"></code>
													</div>
												</div>
											</template>
										</div>
									</div>

									<!-- Request Headers Dictionary -->
									<div class="apidoc-spec-group" x-show="documentedHeaders.length">
										<h3 class="apidoc-group-title">Request headers</h3>
										<div class="apidoc-prop-list">
											<template x-for="item in documentedHeaders" :key="item.key">
												<div class="apidoc-prop-row">
													<div class="apidoc-prop-head">
														<code class="apidoc-prop-name" x-text="item.key"></code>
														<span class="apidoc-prop-type">header</span>
													</div>
													<div class="apidoc-prop-desc">
														<span>Example value: </span>
														<code class="apidoc-prop-val" x-text="item.value || '(present)'"></code>
													</div>
												</div>
											</template>
										</div>
									</div>

									<!-- Request Body Schema / Example -->
									<div class="apidoc-spec-group" x-show="hasBodyExample">
										<div class="apidoc-group-title-row">
											<h3 class="apidoc-group-title">Request body</h3>
											<div class="apidoc-group-actions">
												<span class="apidoc-mime-pill" x-text="requestExample.body_mode === 'form' ? 'application/x-www-form-urlencoded' : requestExample.body_mode === 'text' ? 'text/plain' : 'application/json'"></span>
												<button type="button" class="apidoc-mini-btn" @click="copyText(formattedExampleBody, 'Request body example copied.')">Copy JSON</button>
											</div>
										</div>
										<pre class="pub-code-block" tabindex="0"><code x-text="formattedExampleBody"></code></pre>
									</div>

									<div class="apidoc-no-params" x-show="!routeParams.length && !documentedQueryParams.length && !documentedHeaders.length && !hasBodyExample">
										<span>No path, query, header, or body parameters are required for this <strong x-text="endpoint.method"></strong> request.</span>
									</div>
								</section>

								<!-- Section 2: Responses & Scenario Tabs -->
								<section id="apidoc-routing-spec" class="apidoc-section">
									<div class="apidoc-section-head">
										<div class="apidoc-section-title-row">
											<h2>Responses</h2>
											<span class="apidoc-count-pill" x-text="scenarios.length + (scenarios.length === 1 ? ' scenario' : ' scenarios')"></span>
										</div>
										<p>Scenarios are evaluated from Priority #1 downward. Select a response tab to view its trigger condition and payload.</p>
									</div>

									<!-- Scenario Selector Tabs -->
									<div class="apidoc-scenario-tabs" role="tablist" aria-label="Response scenarios" x-show="scenarios.length > 1">
										<template x-for="row in scenarios" :key="row.key">
											<button
												type="button"
												role="tab"
												class="apidoc-scenario-tab"
												:class="[activeScenario?.key === row.key && 'is-active', lastMatchedResponseID && lastMatchedResponseID === row.responseID && 'is-matched']"
												@click="activeScenarioKey = row.key"
											>
												<span class="apidoc-tab-status" :class="row.status >= 500 ? 'status-5xx' : row.status >= 400 ? 'status-4xx' : row.status >= 300 ? 'status-3xx' : 'status-2xx'" x-text="row.status"></span>
												<span class="apidoc-tab-label" x-text="row.label"></span>
												<span class="apidoc-tab-order" x-text="row.isDefault ? 'Default' : '#' + row.priority"></span>
											</button>
										</template>
									</div>

									<!-- Focused Active Scenario Panel -->
									<template x-if="activeScenario">
										<article class="apidoc-response-block" :class="lastMatchedResponseID && lastMatchedResponseID === activeScenario.responseID && 'is-matched'">
											<header class="apidoc-response-head">
												<div class="apidoc-response-identity">
													<span class="scenario-status-badge" :class="activeScenario.status >= 500 ? 'status-5xx' : activeScenario.status >= 400 ? 'status-4xx' : activeScenario.status >= 300 ? 'status-3xx' : 'status-2xx'" x-text="'HTTP ' + activeScenario.status"></span>
													<strong class="apidoc-response-label" x-text="activeScenario.label"></strong>
													<span class="apidoc-response-meta" x-text="(activeScenario.isDefault ? 'Default fallback' : 'Priority #' + activeScenario.priority) + (activeScenario.responseMode === 'dynamic' ? ' · Dynamic' : '') + (activeScenario.delay ? ' · ' + activeScenario.delay + ' ms' : '')"></span>
												</div>
												<button type="button" class="apidoc-try-scenario-btn" @click="loadScenarioIntoPlayground(activeScenario)" title="Populate Playground with matching inputs">
													<span>Try in Playground →</span>
												</button>
											</header>

											<!-- Clean Trigger Rules -->
											<div class="apidoc-response-conditions" x-show="activeScenario.conditionDetails.length">
												<div class="apidoc-cond-caption">When this response is returned</div>
												<div class="apidoc-rule-list">
													<template x-for="cond in activeScenario.conditionDetails" :key="cond.id + ':' + cond.matched">
														<div class="apidoc-rule-row" :class="cond.matched ? 'is-match' : 'is-nomatch'">
															<span class="apidoc-rule-badge" x-text="cond.matched ? 'Matches' : 'Does not match'"></span>
															<code class="apidoc-rule-code" x-text="cond.summary"></code>
															<span class="apidoc-rule-meta" x-text="cond.meta"></span>
														</div>
													</template>
												</div>
											</div>

											<div class="apidoc-response-fallback" x-show="activeScenario.isDefault">
												<span>Returned automatically when no higher-priority scenario matches the incoming request.</span>
											</div>

											<!-- Response Payload Sample -->
											<div class="apidoc-response-sample" x-show="activeScenario.body">
												<div class="pub-scenario-body-head">
													<span>Response body (application/json)</span>
													<button type="button" class="apidoc-mini-btn" @click="copyText(formatValue(activeScenario.body), 'Scenario response body copied.')">Copy JSON</button>
												</div>
												<pre class="pub-code-block" tabindex="0"><code x-text="formatValue(activeScenario.body)"></code></pre>
											</div>
										</article>
									</template>
								</section>
							</div>
						</main>

						<!-- Right Pane: Sticky Developer Console (Code Samples + Live Playground) -->
						<aside class="apidoc-console" aria-label="Interactive API Playground and Code Samples">
							<div class="apidoc-console-sticky">
								<!-- Panel 1: Live Code Sample Generator (cURL / JS fetch) -->
								<section class="apidoc-console-card apidoc-snippet-card">
									<header class="apidoc-console-header">
										<span class="apidoc-console-title">REQUEST SNIPPET</span>
										<div class="apidoc-lang-tabs" role="tablist" aria-label="Code sample language">
											<button type="button" role="tab" :class="snippetLang === 'curl' && 'active'" @click="snippetLang = 'curl'">cURL</button>
											<button type="button" role="tab" :class="snippetLang === 'fetch' && 'active'" @click="snippetLang = 'fetch'">JS fetch()</button>
										</div>
										<button type="button" class="apidoc-console-copy" @click="copyText(snippetLang === 'fetch' ? fetchSnippet : curlSnippet, (snippetLang === 'fetch' ? 'JavaScript fetch' : 'cURL') + ' snippet copied.')">Copy</button>
									</header>
									<pre class="apidoc-terminal-code" tabindex="0"><code x-text="snippetLang === 'fetch' ? fetchSnippet : curlSnippet"></code></pre>
								</section>

								<!-- Panel 2: Interactive Per-API Playground -->
								<section class="apidoc-console-card apidoc-playground-card" @keydown.ctrl.enter.prevent="sendRequest()" @keydown.meta.enter.prevent="sendRequest()">
									<header class="apidoc-console-header">
										<div>
											<span class="apidoc-console-title">API PLAYGROUND</span>
										</div>
										<div class="pub-play-actions">
											<button type="button" class="apidoc-console-reset" @click="resetPlayground()" title="Reset inputs to endpoint example">Reset</button>
											<button type="button" class="apidoc-send-btn" :disabled="testing" @click="sendRequest()">
												<span x-text="testing ? 'Sending…' : 'Send Request ▶'"></span>
											</button>
										</div>
									</header>

									<!-- Resolved Live Request URL Bar -->
									<div class="pub-resolved-url-bar">
										<span class="method v2-method" :class="[(endpoint?.method || 'GET').toLowerCase(), 'v2-' + (endpoint?.method || 'GET').toLowerCase()]" x-text="endpoint.method"></span>
										<code class="pub-resolved-url" x-text="resolvedPlaygroundURL"></code>
										<button type="button" class="base-url-copy-btn" aria-label="Copy resolved request URL" title="Copy resolved URL" @click="copyText(resolvedPlaygroundURL, 'Request URL copied.')">
											@V2Icon("copy")
										</button>
									</div>

									<!-- Playground Input Tabs -->
									<nav class="scenario-tabs pub-play-tabs" aria-label="Playground request sections">
										<button type="button" :class="playTab === 'params' && 'active'" @click="playTab = 'params'">
											<span>Params</span>
											<span class="scenario-tab-badge" x-show="routeParams.length + playQuery.filter(q => q.key.trim()).length" x-text="routeParams.length + playQuery.filter(q => q.key.trim()).length"></span>
										</button>
										<button type="button" :class="playTab === 'headers' && 'active'" @click="playTab = 'headers'">
											<span>Headers</span>
											<span class="scenario-tab-badge" x-show="playHeaders.filter(h => h.key.trim()).length" x-text="playHeaders.filter(h => h.key.trim()).length"></span>
										</button>
										<button type="button" :class="playTab === 'body' && 'active'" @click="playTab = 'body'" x-show="supportsBody">
											<span>Body</span>
											<span class="scenario-tab-badge" x-text="playBodyMode.toUpperCase()"></span>
										</button>
									</nav>

									<!-- Tab 1: Path & Query Params -->
									<div class="pub-play-tab-body" x-show="playTab === 'params'">
										<div class="pub-play-group" x-show="routeParams.length">
											<div class="field-section-heading">
												<strong>Path Parameters</strong>
											</div>
											<template x-for="param in routeParams" :key="param">
												<div class="pub-kv-row">
													<code class="pub-kv-fixed-key" x-text="':' + param"></code>
													<input class="v2-input" :aria-label="'Path parameter ' + param" x-model="playParams[param]" :placeholder="param + ' value'"/>
												</div>
											</template>
										</div>

										<div class="pub-play-group">
											<div class="field-section-heading">
												<strong>Query Parameters</strong>
												<button type="button" class="text-button" @click="playQuery.push({key: '', value: ''})">+ Add query</button>
											</div>
											<template x-for="(q, idx) in playQuery" :key="idx">
												<div class="header-field-row">
													<input aria-label="Query key" placeholder="page" x-model="q.key"/>
													<input aria-label="Query value" placeholder="1" x-model="q.value"/>
													<button type="button" aria-label="Remove query parameter" @click="playQuery.splice(idx, 1)">✕</button>
												</div>
											</template>
											<p class="help" x-show="!playQuery.length">No query parameters set. Click <strong>+ Add query</strong> to append URL query parameters.</p>
										</div>
									</div>

									<!-- Tab 2: Request Headers -->
									<div class="pub-play-tab-body" x-show="playTab === 'headers'">
										<div class="field-section-heading">
											<strong>Request Headers</strong>
											<button type="button" class="text-button" @click="playHeaders.push({key: '', value: ''})">+ Add header</button>
										</div>
										<template x-for="(h, idx) in playHeaders" :key="idx">
											<div class="header-field-row">
												<input aria-label="Header name" placeholder="Authorization" x-model="h.key"/>
												<input aria-label="Header value" placeholder="Bearer token" x-model="h.value"/>
												<button type="button" aria-label="Remove header" @click="playHeaders.splice(idx, 1)">✕</button>
											</div>
										</template>
										<p class="help" x-show="!playHeaders.length">No custom headers set. Click <strong>+ Add header</strong> to include request headers.</p>
									</div>

									<!-- Tab 3: Request Body -->
									<div class="pub-play-tab-body" x-show="supportsBody && playTab === 'body'">
										<div class="pub-body-mode-row">
											<label for="pub-play-body-mode" class="v2-label">Content format</label>
											<select id="pub-play-body-mode" class="v2-select" x-model="playBodyMode">
												<option value="json">Raw JSON</option>
												<option value="form">Form fields (JSON map)</option>
												<option value="text">Raw Text</option>
											</select>
										</div>
										<textarea x-show="playBodyMode === 'json'" class="code-editor" aria-label="JSON request body" spellcheck="false" x-model="playBodyJSON" placeholder='{"key": "value"}'></textarea>
										<textarea x-show="playBodyMode === 'form'" class="code-editor" aria-label="Form fields JSON" spellcheck="false" x-model="playBodyForm" placeholder='{"email": ["user@example.com"]}'></textarea>
										<textarea x-show="playBodyMode === 'text'" class="code-editor" aria-label="Raw text request body" spellcheck="false" x-model="playBodyText" placeholder="Raw request payload"></textarea>
									</div>

									<p class="dialog-error" role="alert" x-show="playError" x-text="playError"></p>

									<!-- Live Response Output -->
									<div class="pub-response-panel">
										<div class="pub-response-head">
											<span class="apidoc-console-title">LIVE RESPONSE</span>
											<div class="pub-response-badges" x-show="testResult">
												<span class="scenario-status-badge" :class="testResult?.status >= 500 ? 'status-5xx' : testResult?.status >= 400 ? 'status-4xx' : testResult?.status >= 300 ? 'status-3xx' : 'status-2xx'" x-text="testResult ? 'HTTP ' + testResult.status : ''"></span>
												<span class="scenario-delay-badge" x-show="testResult?.duration_ms !== undefined" x-text="(testResult?.duration_ms || 0) + ' ms'"></span>
												<span class="v2-sample" x-show="matchedScenarioLabel" x-text="matchedScenarioLabel"></span>
												<button type="button" class="apidoc-mini-btn" @click="copyText(formatValue(testResult?.body || ''), 'Response body copied.')">Copy</button>
											</div>
										</div>

										<template x-if="testResult">
											<div class="pub-response-content">
												<pre class="response-output pub-response-pre" tabindex="0" x-text="formatValue(testResult.body)"></pre>

												<!-- Response Headers -->
												<details class="pub-response-details" x-show="testResult.headers && Object.keys(testResult.headers).length">
													<summary>Response Headers (<span x-text="Object.keys(testResult.headers || {}).length"></span>)</summary>
													<div class="pub-headers-kv">
														<template x-for="[hk, hv] in Object.entries(testResult.headers || {})" :key="hk">
															<div class="pub-header-kv-item">
																<code x-text="hk"></code>
																<span x-text="hv"></span>
															</div>
														</template>
													</div>
												</details>

												<!-- Condition Evaluation Diagnostics -->
												<details class="pub-response-details" x-show="testResult.conditions?.length">
													<summary>Condition Evaluation Trace (<span x-text="testResult.conditions?.length || 0"></span>)</summary>
													<div class="condition-test-report">
														<template x-for="(check, idx) in testResult.conditions || []" :key="check.id">
															<div class="condition-test-check">
																<strong x-text="'#' + (idx + 1) + ' ' + check.label"></strong>
																<span class="type-pill v2-sample" x-text="check.evaluated ? (check.matched ? 'Matched' : 'Not matched') : 'Not visited'"></span>
																<p x-text="check.reason"></p>
															</div>
														</template>
													</div>
												</details>
											</div>
										</template>

										<template x-if="!testResult">
											<div class="pub-response-empty">
												<p>Click <strong>Send Request ▶</strong> (or press <kbd>Ctrl+Enter</kbd>) to execute a live request against this mock endpoint.</p>
											</div>
										</template>
									</div>
								</section>
							</div>
						</aside>
					</div>
				</template>
			</div>
		</body>
	</html>
}

templ PublicDocsDisabledPage(slug string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>Public API Docs Unavailable — Mocklab</title>
			<script>try { const value=localStorage.getItem('mocklab-theme'); document.documentElement.dataset.theme=value==='night'||!['light','night'].includes(value)&&matchMedia('(prefers-color-scheme: dark)').matches?'night':'light'; } catch { document.documentElement.dataset.theme='light'; }</script>
			<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg"/>
			<link rel="alternate icon" type="image/x-icon" href="/assets/favicon.ico"/>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body class="apidoc-body">
			<main class="empty-state" style="min-height: 100vh">
				<div class="brand-symbol">☁</div>
				<h1>Public API documentation unavailable</h1>
				<p>The workspace <code>{ slug }</code> either does not exist or its owner has turned off public viewer access.</p>
				<a href="/app" class="btn primary">Sign in to Mocklab ↗</a>
			</main>
		</body>
	</html>
}
