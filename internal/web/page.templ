package web

templ Page() {
 <!DOCTYPE html>
 <html lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Mocklab — API workspace</title>
  <link rel="stylesheet" href="/assets/app.css"/>
  <script type="module" src="/assets/app.js"></script>
 </head>
 <body>
  <div class="app-shell" x-data="mocklab" x-init="boot()" @keydown.escape.window="modal = null; connecting = null" @keydown.ctrl.s.window.prevent="!modal && readyToSave && saveEndpoint()" @keydown.meta.s.window.prevent="!modal && readyToSave && saveEndpoint()">
   @Sidebar()
   <main class="min-w-0 flex flex-col">
    @Toolbar()
    <div class="notice" role="status" x-show="notice" x-cloak x-text="notice"></div>
    <template x-if="!workspace">
     <section class="empty-state"><div class="brand-symbol">m</div><h1>Your next API starts here.</h1><p>Create a workspace to design, test, and run REST API mocks.</p><button class="btn primary" @click="openWorkspace()">+ Create workspace</button></section>
    </template>
    <template x-if="workspace && !endpoint">
     <section class="empty-state"><span class="eyebrow">WORKSPACE READY</span><h1>Give your ideas an endpoint.</h1><p>Start with a simple response, then add logic in the visual editor.</p><button class="btn primary" @click="newEndpoint()">+ Add endpoint</button></section>
    </template>
    <template x-if="endpoint">
     <div class="editor-shell">
      @EndpointBar()
      @FlowValidation()
      @FlowCanvas()
      @TableEditor()
      @SaveBar()
      @TestPanel()
     </div>
    </template>
    <footer><span>MOCKLAB <span class="text-slate-400">/ local workspace</span></span><span hx-get="/app/status" hx-trigger="load, every 30s" hx-swap="innerHTML">Connecting…</span></footer>
   </main>
   @Dialogs()
  </div>
 </body>
 </html>
}

templ Sidebar() {
 <aside class="sidebar">
  <a href="/app" class="brand"><span class="brand-symbol">m</span><span>mocklab<span class="brand-period">.</span></span><span class="badge">BETA</span></a>
  <div class="sidebar-label">WORKSPACE <button aria-label="Add workspace" @click="openWorkspace()">+</button></div>
  <select class="workspace-select" aria-label="Select workspace" x-model="workspaceID" @change="selectWorkspace(workspaceID)"><option value="">Select workspace</option><template x-for="w in workspaces" :key="w.id"><option :value="w.id" x-text="w.name"></option></template></select>
  <div class="workspace-actions" x-show="workspace"><button @click="openWorkspace(workspace)">Edit workspace</button><button @click="removeWorkspace()">Delete</button></div>
  <div class="workspace-url" x-show="workspace" x-cloak><span class="eyebrow">BASE URL</span><code x-text="baseURL"></code><button class="text-button" @click="copyBaseURL()">Copy base URL ↗</button></div>
  <div class="sidebar-label mt-8">ENDPOINTS <span x-text="endpoints.length"></span></div>
  <input class="search-input" placeholder="Search endpoints…" aria-label="Search endpoints" x-model="search"/>
  <nav class="endpoint-list"><template x-for="e in filteredEndpoints" :key="e.id"><button class="endpoint-link" :class="endpoint?.id === e.id ? 'active' : ''" @click="selectEndpoint(e)"><span class="method" :class="e.method.toLowerCase()" x-text="e.method"></span><span class="truncate" x-text="e.path"></span></button></template></nav>
  <button class="add-endpoint" :disabled="!workspace" @click="newEndpoint()">+ Add endpoint</button>
  <div class="sidebar-bottom"><span class="mini-icon">◇</span><div><strong>Build before the backend.</strong><p>One workspace. Endless possibilities.</p></div></div>
 </aside>
}

templ Toolbar() {
 <header class="toolbar"><div class="breadcrumbs"><span>Workspaces</span><span>/</span><strong x-text="workspace?.name || 'Overview'"></strong><span class="unsaved" x-show="dirty" x-cloak>Unsaved</span></div><div class="flex gap-2 items-center"><span class="local-badge">● LOCAL</span><button class="btn primary" :disabled="!readyToSave" @click="saveEndpoint()" x-text="busy ? 'Saving…' : dirty ? 'Save changes' : 'Saved'"></button></div></header>
}

templ EndpointBar() {
 <section class="endpoint-bar"><div><span class="eyebrow">ENDPOINT EDITOR</span><div class="endpoint-title endpoint-readonly"><span class="route-method" x-text="endpoint.method"></span><code x-text="endpoint.path"></code></div><div class="base-url"><span>BASE URL</span><code x-text="baseURL"></code><button @click="copyBaseURL()" aria-label="Copy base URL">Copy base URL ↗</button><button @click="copyURL()" aria-label="Copy endpoint URL">Copy endpoint ↗</button></div></div><div class="flex gap-2 items-center"><div class="view-switch"><button :class="mode === 'node' && 'selected'" @click="mode = 'node'">◇ Node</button><button :class="mode === 'table' && 'selected'" @click="mode = 'table'">▤ Table</button></div><button class="btn danger-quiet" @click="removeEndpoint()" aria-label="Delete endpoint">Delete</button></div></section>
}

templ SaveBar() {
 <div class="editor-save-bar" x-show="dirty" x-cloak><div><strong>Changes are still a draft</strong><span>Test the response, then save to update the mock API.</span></div><div class="save-bar-actions"><button class="text-button" x-show="undoSnapshot" @click="undoChange()" :disabled="busy">Undo last change</button><button class="btn" @click="discardChanges()" :disabled="busy">Discard draft</button><button class="btn primary" @click="saveEndpoint()" :disabled="!readyToSave" x-text="busy ? 'Saving…' : 'Save &amp; activate'"></button></div></div>
}

templ FlowValidation() {
 <div class="condition-warning" x-show="conditionWarnings.length" x-cloak><strong>Review conditions</strong><template x-for="warning in conditionWarnings" :key="warning"><p x-text="warning"></p></template></div>
 <div class="flow-validation" role="alert" x-show="flowIssues.length" x-cloak><strong>Fix connections before saving</strong><template x-for="issue in flowIssues" :key="issue"><p x-text="issue"></p></template></div>
}

templ FlowCanvas() {
 <section class="canvas-section" x-show="mode === 'node'">
  <div class="canvas-toolbar"><div><span class="status-dot"></span><strong>Visual flow</strong><span class="text-slate-400" x-text="endpoint.flow.nodes.length + ' nodes'"></span></div><div class="canvas-actions"><div class="canvas-zoom" role="group" aria-label="Canvas zoom"><button type="button" class="btn" aria-label="Zoom out" title="Zoom out (minimum 50%)" :disabled="zoom <= minZoom" @click="setZoom(zoom - zoomStep)">−</button><button type="button" class="btn zoom-reset" aria-label="Reset zoom to 100%" title="Reset zoom to 100%" @click="setZoom(1)" x-text="Math.round(zoom * 100) + '%' "></button><button type="button" class="btn" aria-label="Zoom in" title="Zoom in (maximum 200%)" :disabled="zoom >= maxZoom" @click="setZoom(zoom + zoomStep)">+</button></div><button class="btn primary" @click="openAddScenario()">+ Add node</button></div></div>
  <div class="canvas-scroll"><div class="canvas-extent" :style="`width:${canvasWidth * zoom}px;height:${canvasHeight * zoom}px`"><div class="flow-canvas" :style="`width:${canvasWidth}px;height:${canvasHeight}px;transform:scale(${zoom})`" @pointermove.window="moveNode($event)" @pointerup.window="drag = null">
   <template x-for="edge in endpoint.flow.edges" :key="edge.from + ':' + (edge.branch || '')">
    <svg class="connections" :width="canvasWidth" :height="canvasHeight" aria-label="Flow connections">
     <defs><marker :id="'arrow-' + edge.from + '-' + (edge.branch || 'next')" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="none" stroke="currentColor"></path></marker></defs>
     <g class="connection-group" role="button" tabindex="0" :aria-label="'Edit connection ' + targetLabel(edge.from, edge.branch || '')" @click="editConnection(edge)" @keydown.enter.prevent="editConnection(edge)">
      <path class="connection-hit" :d="edgePath(edge)"></path><path class="connection-line" :d="edgePath(edge)" :class="edgeTraced(edge) && 'traced'" :marker-end="'url(#arrow-' + edge.from + '-' + (edge.branch || 'next') + ')'"></path><text :x="edgeMid(edge).x" :y="edgeMid(edge).y" x-text="edge.branch === 'true' ? 'Yes' : edge.branch === 'false' ? 'No' : ''"></text>
     </g>
    </svg>
   </template>
   <template x-for="node in endpoint.flow.nodes" :key="node.id">
    <article class="flow-node" :class="[node.type, node.id === highlightedNodeID && 'recent-node', trace.includes(node.id) && 'executed', connecting?.from === node.id && 'connecting']" :style="`left:${node.x}px;top:${node.y}px`">
     <div class="node-heading" @pointerdown="startDrag($event, node)"><span class="node-icon" x-text="node.type === 'condition' ? conditionIcon(node.config) : nodeIcon(node.type)"></span><span x-text="node.label"></span><button class="node-edit" @pointerdown.stop @click="editNodeScenario(node)" :aria-label="'Edit ' + node.label">Edit</button></div>
     <div class="node-content"><span class="node-type" x-text="node.type === 'condition' ? conditionMeta(node.config) : node.type"></span><code x-text="nodeSummary(node)"></code></div>
     <div class="node-actions"><button x-show="node.type !== 'response'" @click="editNodeConnections(node)">Edit connection ↗</button><span x-show="node.type === 'response'">End of flow</span></div>
     <div class="node-ports">
      <button x-show="node.type !== 'request'" class="port-input" :class="connecting && 'available'" @click="connectTo(node)" :aria-label="'Connect to ' + node.label"><span class="port-label">Input</span></button>
      <template x-if="node.type === 'condition'"><div><button class="port-output branch-true" @click="startConnection(node, 'true')" :aria-label="'Connect Yes branch from ' + node.label"><span class="port-label">Yes</span></button><button class="port-output branch-false" @click="startConnection(node, 'false')" :aria-label="'Connect No branch from ' + node.label"><span class="port-label">No</span></button></div></template>
      <button x-show="!['condition','response'].includes(node.type)" class="port-output" @click="startConnection(node, '')" :aria-label="'Connect output from ' + node.label"><span class="port-label">Output</span></button>
     </div>
    </article>
   </template>
  </div></div></div>
  <div class="canvas-hint"><span x-text="connecting ? 'Click the destination Input port. Press Escape to cancel.' : 'Drag nodes to arrange them · Click a line or Edit connection to change connections'"></span><span>Output port → Input</span></div>
 </section>
}

templ TableEditor() {
 <section class="flow-table-panel" x-show="mode === 'table'">
  <header class="flow-table-heading"><div><span class="eyebrow">REQUEST FLOW</span><h2>Request &amp; response flow</h2><p>Each row represents one path. Conditions are evaluated in order; the default response is the fallback.</p></div><button class="btn primary" @click="openAddScenario()">+ Add condition</button></header>
  <div class="flow-table-info"><span class="status-dot"></span><span>Incoming request</span><span>→</span><strong x-text="conditions.length ? conditions.length + ' conditions → default response' : 'Default response · no conditions'"></strong><span class="row-count" x-text="scenarioRows.length + ' paths'"></span></div>
  <div class="table-overflow"><table class="scenario-table"><thead><tr><th>#</th><th>REQUEST PATH</th><th>CONDITIONS</th><th>RESPONSE</th><th>HEADERS</th><th>ACTION</th></tr></thead><tbody>
   <template x-for="row in scenarioRows" :key="row.key"><tr :class="row.isDefault && 'default-scenario-row'"><td><span class="scenario-order" x-text="row.order"></span></td><td><div class="scenario-name"><span class="scenario-icon" x-text="row.isDefault ? '↳' : '◇'"></span><strong x-text="row.label"></strong><span class="default-tag" x-show="row.isDefault">DEFAULT</span></div><p class="scenario-path" x-text="scenarioPath(row)"></p></td><td><span class="scenario-condition" x-text="scenarioConditionSummary(row)"></span></td><td><span class="response-code" x-text="row.status"></span><code class="scenario-body-preview" x-text="row.body || '(empty body)'"></code></td><td><span class="header-count" x-text="scenarioHeaderCount(row) + ' headers'"></span></td><td><button class="btn scenario-edit" @click="editScenario(row)" :aria-label="'Edit path ' + row.label">Edit ↗</button></td></tr></template>
  </tbody></table></div>
  <div class="config-empty" x-show="!scenarioRows.length">The flow is not connected to a response. Check connections in Node mode.</div><div class="flow-validation" x-show="scenarioProjection.truncated">The table displays up to 128 paths. Use Node mode to review more complex graphs.</div>
  <footer class="scenario-table-footer"><span>A default response is available. Add conditions for different response scenarios.</span><span>Configure everything through Action → Edit</span></footer>
 </section>
}

templ TestPanel() {
 <section class="test-panel"><div class="canvas-toolbar"><div><strong>Request playground</strong><span class="text-slate-400">Test your flow before saving</span></div><button class="btn" @click="testOpen = !testOpen" x-text="testOpen ? 'Close' : 'Open'"></button><button class="btn dark" :disabled="testing" @click="runTest()" x-text="testing ? 'Running…' : '▷ Run test'"></button></div><div class="test-grid" x-show="testOpen"><div><label>INPUT JSON <span class="text-slate-400">params · query · headers · body</span></label><textarea aria-label="Test request JSON" class="code-editor" x-model="testInput" spellcheck="false"></textarea></div><div><label>RESPONSE <span class="response-status" x-show="testResult" x-text="testResult?.status"></span></label><pre class="response-output" x-text="testResult ? JSON.stringify(testResult, null, 2) : '// The response will appear here'"></pre></div></div></section>
}

templ Dialogs() {
 <div class="modal-backdrop" x-show="modal" x-cloak @click.self="modal = null" role="presentation">
  <section class="modal" :class="modal === 'scenario' && 'scenario-modal'" role="dialog" aria-modal="true" :aria-label="modalTitle" x-trap.noscroll="modal" @keydown.ctrl.enter.prevent="commitModal()">
   <header><div><span class="eyebrow">MOCKLAB BUILDER</span><h2 x-text="modalTitle"></h2></div><button @click="modal = null" aria-label="Close dialog">✕</button></header>
   <template x-if="modal === 'workspace'"><form @submit.prevent="saveWorkspace()"><label>Workspace name<input x-model="workspaceForm.name" required placeholder="Demo Store"/></label><label>Slug / base path<input x-model="workspaceForm.slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="demo-store"/></label><p class="help">Mock URL: /public/<span x-text="workspaceForm.slug || 'workspace'"></span>/…</p><button class="btn primary w-full" :disabled="busy">Save workspace</button></form></template>
   <template x-if="modal === 'endpoint'"><form @submit.prevent="createEndpoint()"><label>Endpoint name<input x-model="endpointForm.name" required placeholder="Get product"/></label><label>HTTP method<select x-model="endpointForm.method"><template x-for="m in methods"><option x-text="m"></option></template></select></label><label>Path<input x-model="endpointForm.path" required placeholder="/products/:id"/></label><div class="new-endpoint-hint"><strong>✓ A default response is available</strong><p>Incoming request → Default response (HTTP 200). Add a condition template for another scenario; configure it through the row's Edit button.</p></div><button class="btn primary w-full" :disabled="busy">Create endpoint with response 200</button></form></template>
   <template x-if="modal === 'palette'"><div><p class="help">Choose a type to create a connected node with one required field and AND matching. Configure details later using Edit.</p><div class="palette-context" x-show="connecting"><span x-text="'Insert at output: ' + (endpoint.flow.nodes.find(node => node.id === connecting?.from)?.label || '') + (connecting?.branch ? ' · ' + connecting.branch : '')"></span></div><div class="condition-palette"><template x-for="kind in conditionKinds" :key="kind.key"><button type="button" @click="quickAddCondition(kind.key)" :disabled="!canAddCondition(kind.key)"><span class="palette-icon" x-text="kind.icon"></span><strong x-text="kind.name"></strong><p x-text="kind.description"></p><span class="palette-hint" x-text="canAddCondition(kind.key) ? (kind.key === 'body' ? 'Default: Raw JSON · Edit for Form/Text' : 'Create node now →') : 'The route has no :parameter'"></span></button></template></div></div></template>
   <template x-if="modal === 'scenario' && scenarioForm"><form class="scenario-form" @submit.prevent="saveScenario()">
    <p class="scenario-shared-note">Request settings apply to this endpoint. Changes to shared conditions or responses affect every related path. The active version is updated when you save the draft.</p>
    <nav class="scenario-tabs" aria-label="Flow configuration sections"><button type="button" :class="scenarioTab === 'request' && 'active'" @click="scenarioTab='request'">Request</button><button type="button" :class="scenarioTab === 'conditions' && 'active'" @click="scenarioTab='conditions'">Conditions</button><button type="button" :class="scenarioTab === 'response' && 'active'" @click="scenarioTab='response'">Response</button><button type="button" x-show="scenarioForm.fallback" :class="scenarioTab === 'fallback' && 'active'" @click="scenarioTab='fallback'">Default response</button><button type="button" :class="scenarioTab === 'advanced' && 'active'" @click="scenarioTab='advanced'">Advanced flow</button></nav>
    <section x-show="scenarioTab === 'request'">
     <label>Endpoint name<input x-model="scenarioForm.route.name"/></label><div class="insertion-controls"><label>Method<select x-model="scenarioForm.route.method"><template x-for="method in methods" :key="method"><option x-text="method"></option></template></select></label><label>Path<input x-model="scenarioForm.route.path" placeholder="/products/:id"/></label></div>
     <label>Path parameters (JSON string values)<textarea class="code-editor short" x-model="scenarioForm.params" spellcheck="false"></textarea></label><label>Query parameters (JSON arrays of strings)<textarea class="code-editor short" x-model="scenarioForm.query" spellcheck="false"></textarea></label>
     @ScenarioHeaders("scenarioForm.headers")
     <label>Request body example format<select x-model="scenarioForm.bodyMode"><option value="json">Raw JSON</option><option value="form">Form</option><option value="text">Raw Text</option></select></label><label x-show="scenarioForm.bodyMode === 'json'">JSON body example<textarea class="code-editor" x-model="scenarioForm.body" spellcheck="false"></textarea></label><label x-show="scenarioForm.bodyMode === 'form'">Form fields (JSON arrays of strings)<textarea class="code-editor" x-model="scenarioForm.form" spellcheck="false" placeholder='{"email":["demo@example.com"]}'></textarea></label><label x-show="scenarioForm.bodyMode === 'text'">Raw text example<textarea class="code-editor" x-model="scenarioForm.rawBody" spellcheck="false"></textarea></label><p class="help">Request examples are loaded into the playground. Conditions evaluate actual incoming API requests.</p>
    </section>
    <section x-show="scenarioTab === 'conditions'">
     <template x-if="scenarioIsNew"><div class="scenario-template-picker"><label>Condition template<select :value="scenarioTemplate" @change="chooseScenarioTemplate($event.target.value)"><template x-for="item in conditionTemplates" :key="item.key"><option :value="item.key" :disabled="item.key === 'path' && !availablePathFields.length" x-text="item.name"></option></template></select></label><p class="help" x-text="conditionTemplates.find(item => item.key === scenarioTemplate)?.description"></p><p class="help">Templates select the field source. Configure the response and fallback in their tabs. Changing the template resets this popup's draft.</p></div></template>
     <div class="default-rule-note" x-show="scenarioForm.isDefault">This is the default response, used when no conditions match. A direct response does not need conditions.</div>
     <div class="condition-warning" x-show="scenarioConditionWarnings.length"><template x-for="warning in scenarioConditionWarnings" :key="warning"><p x-text="warning"></p></template></div>
     <template x-for="condition in scenarioForm.conditions" :key="condition.id"><div class="scenario-condition-editor"><div class="condition-match-heading"><span class="type-pill" x-text="condition.matched ? 'Matching path' : 'Previous condition did not match'"></span><button type="button" class="text-button danger-text" x-show="condition.matched && !scenarioIsNew" @click="removeScenarioCondition(condition.id)">Delete condition</button></div><label>Condition node name<input x-model="condition.label"/></label><div class="insertion-controls"><label>Condition type<select :value="condition.config.condition_type" @change="changeConditionKind(condition,$event.target.value)"><template x-for="kind in conditionKinds" :key="kind.key"><option :value="kind.key" :disabled="kind.key === 'path' && !availablePathFields.length" x-text="kind.name"></option></template></select></label><label>Matching<select x-model="condition.config.match"><option value="all">All fields match (AND)</option><option value="any">Any field matches (OR)</option></select></label></div>
      <template x-if="condition.config.condition_type === 'body'"><div class="insertion-controls"><label>Body mode<select x-model="condition.config.body_mode" @change="changeBodyMode(condition)"><option value="raw">Raw</option><option value="form">Form</option></select></label><label x-show="condition.config.body_mode === 'raw'">Raw format<select x-model="condition.config.raw_format" @change="changeBodyMode(condition)"><option value="json">JSON</option><option value="text">Text</option></select></label></div></template>
      <div class="field-section-heading"><strong x-text="condition.config.rules.length + ' fields in this node'"></strong><button type="button" class="text-button" :disabled="condition.config.rules.length >= 50" @click="addConditionField(condition)">+ Add field</button></div>
      <div class="condition-rules-scroll"><div class="condition-rules-head"><span>FIELD</span><span>OPERATOR</span><span>VALUE</span><span>REQUIRED</span><span></span></div><template x-for="(rule,index) in condition.config.rules" :key="index"><div class="condition-rule-row"><template x-if="condition.config.condition_type === 'path'"><select aria-label="Path parameter field" x-model="rule.field"><option value="">Select parameter</option><template x-for="field in availablePathFields" :key="field"><option :value="field" x-text="field"></option></template></select></template><template x-if="condition.config.condition_type !== 'path'"><input aria-label="Condition field" x-model="rule.field" :readonly="condition.config.condition_type === 'body' && condition.config.body_mode === 'raw' && condition.config.raw_format === 'text'" :placeholder="condition.config.condition_type === 'header' ? 'Authorization' : condition.config.condition_type === 'query' ? 'page' : 'user.email'"/></template><select aria-label="Condition operator" x-model="rule.operator"><option value="exists">Exists</option><option value="equals">Equals</option><option value="not_equals">Not equals</option><option value="contains">Contains</option><option value="empty">Empty / missing</option></select><input aria-label="Condition value" x-model="rule.value" :disabled="['exists','empty'].includes(rule.operator)" :placeholder="['exists','empty'].includes(rule.operator) ? 'Not needed' : 'Comparison value'"/><label class="required-check"><input type="checkbox" x-model="rule.required" aria-label="Field must not be empty"/><span>Required</span></label><button type="button" @click="condition.config.rules.splice(index,1)" :disabled="condition.config.rules.length === 1" aria-label="Delete condition field">✕</button></div></template></div>
      <p class="help">Required: the field must be present and nonempty for this rule to match. Null, whitespace, and empty objects/arrays are rejected; 0 and false remain valid. Exists without Required only checks presence. OR matches when any rule is satisfied.</p>
     </div></template>
     <p class="help" x-show="!scenarioForm.conditions.length">Incoming requests go directly to the default response. Use Add condition if another scenario is needed.</p>
    </section>
    <section x-show="scenarioTab === 'response'">@ScenarioResponse("response", "Response for this path")</section>
    <template x-if="scenarioForm.fallback"><section x-show="scenarioTab === 'fallback'"><p class="default-rule-note">The default response applies when no conditions match. Changes update this endpoint's fallback.</p>@ScenarioResponse("fallback", "Default response")</section></template>
    <section x-show="scenarioTab === 'advanced'">
     <div class="scenario-advanced-note">Existing graph settings are preserved. Change destinations as needed; all nodes must stay connected and the graph must have no cycles.</div>
     <template x-for="edge in scenarioForm.connections" :key="edge.from + ':' + (edge.branch || '')"><label><span x-text="scenarioDraft.nodes.find(node => node.id === edge.from)?.label + (edge.branch ? ' · ' + (edge.branch === 'true' ? 'match' : 'no match') : '')"></span><select x-model="edge.to"><template x-for="target in scenarioDraft.nodes.filter(node => node.type !== 'request' && node.id !== edge.from)" :key="target.id"><option :value="target.id" x-text="target.label"></option></template></select></label></template>
     <template x-for="block in scenarioForm.legacyHeaders" :key="block.id"><div class="scenario-condition-editor"><strong x-text="block.label"></strong>@ScenarioHeaders("block.headers")</div></template>
     <template x-for="block in scenarioForm.legacyDelays" :key="block.id"><label><span x-text="block.label + ' (ms)'"></span><input type="number" min="0" max="10000" x-model.number="block.delay_ms"/></label></template>
    </section>
    <div class="scenario-popup-footer"><button type="button" class="btn" @click="modal=null">Cancel</button><button class="btn primary" x-text="scenarioIsNew ? 'Add condition to draft' : 'Apply all to draft'"></button></div>
   </form></template>
   <template x-if="modal === 'connection'"><form @submit.prevent="saveConnection()"><label>From step<select x-model="connectionForm.from" @change="connectionSourceChanged()"><template x-for="source in insertionSources" :key="source.id"><option :value="source.id" x-text="source.label"></option></template></select></label><label>Branch<select x-model="connectionForm.branch" @change="connectionBranchChanged()"><template x-for="branch in branchesFor(connectionForm.from)" :key="branch"><option :value="branch" x-text="branch === 'true' ? 'Yes / match' : branch === 'false' ? 'No / fallback' : 'Next'"></option></template></select></label><label>To step<select x-model="connectionForm.to"><option value="">Not connected</option><template x-for="target in orderedNodes.filter(node => node.id !== connectionForm.from && node.type !== 'request')" :key="target.id"><option :value="target.id" x-text="target.label"></option></template></select></label><p class="help">One destination per branch. Cycles are rejected. Connect every branch before saving the endpoint.</p><div class="modal-actions"><button type="button" class="btn danger-quiet" x-show="originalConnection" @click="removeConnection()">Delete connection</button><button class="btn primary">Save connection</button></div></form></template>
   <p class="dialog-error" role="alert" x-show="dialogError" x-text="dialogError"></p>
  </section>
 </div>
}


templ ScenarioHeaders(binding string) {
 <div class="header-fields"><div class="field-section-heading"><strong>Headers</strong><button type="button" class="text-button" @click={ binding + ".push({key:'',value:''})" }>+ Header</button></div><template x-for={ "(header, index) in " + binding } :key="index"><div class="header-field-row"><input aria-label="Header key" placeholder="Content-Type" x-model="header.key"/><input aria-label="Header value" placeholder="application/json" x-model="header.value"/><button type="button" @click={ binding + ".splice(index,1)" } aria-label="Delete header">✕</button></div></template></div>
}

templ ScenarioResponse(section string, title string) {
 <div class="scenario-response-fields"><h3>{ title }</h3><label>Response template<select :value={ "scenarioForm." + section + ".template" } @change={ "selectScenarioResponseTemplate('" + section + "', $event.target.value)" }><option value="keep">Keep / custom</option><template x-for="item in responseTemplates" :key="item.key"><option :value="item.key" x-text="item.name"></option></template></select></label><label>Response name<input x-model={ "scenarioForm." + section + ".label" }/></label><div class="insertion-controls"><label>HTTP status<input type="number" min="200" max="599" x-model.number={ "scenarioForm." + section + ".status" }/></label><label>Response delay (ms)<input type="number" min="0" max="10000" x-model.number={ "scenarioForm." + section + ".delay_ms" }/></label></div>@ScenarioHeaders("scenarioForm." + section + ".headers")<label>JSON body<textarea class="code-editor" x-model={ "scenarioForm." + section + ".body" } spellcheck="false"></textarea></label></div>
}
