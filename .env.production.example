# Internal deployment using the application's existing domain/host.
APP_ENV=internal
# Origin only; the application appends /public/{workspace-slug}.
PUBLIC_BASE_URL=http://apimock.internal:8080
# Default to loopback. Set a private interface address for direct LAN access.
APP_BIND=127.0.0.1
APP_PORT=8080
# First administrator bootstrap; existing database accounts are never overwritten.
ADMIN_USERNAME=admin
# Generate independent random values and fill both empty fields before deployment.
ADMIN_PASSWORD=
# Use at least 32 URL-safe characters, such as a random hexadecimal value.
POSTGRES_PASSWORD=
# Empty allows same-origin browser requests; add exact frontend origins if needed.
MOCK_CORS_ORIGINS=
MOCK_CORS_HEADERS=Content-Type,Authorization,X-Api-Key
