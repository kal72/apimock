package web

import "apimock/internal/domain"

type PublicDocsPayload struct {
	Workspace     domain.Workspace  `json:"workspace"`
	Endpoints     []domain.Endpoint `json:"endpoints"`
	PublicBaseURL string            `json:"public_base_url"`
}

templ PublicDocsPage(workspace domain.Workspace, endpoints []domain.Endpoint, publicBaseURL string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ workspace.Name } — Public API Docs &amp; Playground | Mocklab</title>
			<script>try { const value=localStorage.getItem('mocklab-theme'); document.documentElement.dataset.theme=value==='night'||!['light','night'].includes(value)&&matchMedia('(prefers-color-scheme: dark)').matches?'night':'light'; } catch { document.documentElement.dataset.theme='light'; }</script>
			<link rel="stylesheet" href="/assets/app.css"/>
			@templ.JSONScript("public-docs-data", PublicDocsPayload{
				Workspace:     workspace,
				Endpoints:     endpoints,
				PublicBaseURL: publicBaseURL,
			})
			<script type="module" src="/assets/app.js"></script>
		</head>
		<body x-data="publicDocs">
			<div class="app-shell v2-shell">
				<aside class="sidebar v2-sidebar pub-docs-sidebar" aria-label="API Endpoints Navigation">
					<a href={ templ.SafeURL("/share/" + workspace.Slug) } class="brand v2-brand">
						<span aria-hidden="true">☁</span>
						<span>mocklab</span>
						<span class="badge v2-version">DOCS</span>
					</a>

					<div class="pub-workspace-box">
						<div class="pub-workspace-head">
							<span class="v2-kicker">PUBLIC WORKSPACE</span>
							<span class="pub-live-pill">● LIVE</span>
						</div>
						<strong class="pub-workspace-title" x-text="workspace.name">{ workspace.Name }</strong>
						<div class="workspace-base-url-pill mt-2" @click="copyBaseURL()" title="Click to copy mock base URL">
							<span class="base-url-tag">BASE</span>
							<span class="base-url-text truncate" x-text="baseURL"></span>
							<button type="button" class="base-url-copy-btn" aria-label="Copy mock base URL" @click.stop="copyBaseURL()">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
							</button>
						</div>
					</div>

					<section class="v2-endpoint-list pub-endpoint-section">
						<header>
							<strong>Endpoints <small class="sidebar-count" :class="(search.trim() || methodFilter !== 'ALL') && 'is-filtered'" x-text="(search.trim() || methodFilter !== 'ALL') ? filteredEndpoints.length + '/' + endpoints.length : endpoints.length"></small></strong>
						</header>
						<search aria-label="Filter API endpoints">
							<input class="search-input" type="search" placeholder="Search path or name…" aria-label="Search endpoints" x-model="search"/>
							<div class="pub-method-filters" role="group" aria-label="Filter by HTTP method">
								<template x-for="m in ['ALL', 'GET', 'POST', 'PUT', 'PATCH', 'DELETE']" :key="m">
									<button type="button" class="pub-method-chip" :class="methodFilter === m && 'active'" @click="methodFilter = m" x-text="m"></button>
								</template>
							</div>
						</search>
						<nav class="endpoint-list" aria-label="Endpoints">
							<template x-for="e in filteredEndpoints" :key="e.id">
								<button type="button" class="endpoint-link pub-endpoint-item" :class="endpoint?.id === e.id ? 'active v2-endpoint-selected' : ''" @click="selectEndpoint(e)">
									<b class="method v2-method" :class="[e.method.toLowerCase(), 'v2-' + e.method.toLowerCase()]" x-text="e.method"></b>
									<div class="pub-endpoint-item-text">
										<span class="truncate" x-text="e.path"></span>
										<small class="truncate" x-text="e.name"></small>
									</div>
								</button>
							</template>
							<p class="pub-empty-list" x-show="!filteredEndpoints.length">No endpoints match your filter.</p>
						</nav>
					</section>

					<div class="sidebar-bottom v2-sidebar-note">
						<span class="v2-kicker">PUBLIC API PORTAL</span>
						<p>Interactive documentation &amp; live request playground.</p>
					</div>
				</aside>

				<main id="public-docs-main">
					<header class="toolbar v2-header">
						<nav class="breadcrumbs v2-breadcrumb" aria-label="Breadcrumb">
							<a href={ templ.SafeURL("/share/" + workspace.Slug) } aria-label="Public docs home">@V2Icon("home")</a>
							<span>›</span>
							<strong x-text="workspace.name">{ workspace.Name }</strong>
							<span>›</span>
							<span>Public API Docs</span>
							<span x-show="endpoint" x-cloak>›</span>
							<span class="v2-header-endpoint" x-show="endpoint" x-cloak>
								<b class="v2-method" :class="'v2-' + (endpoint?.method?.toLowerCase() || 'get')" x-text="endpoint?.method"></b>
								<code x-text="endpoint?.path"></code>
							</span>
						</nav>
						<div class="topbar-actions v2-header-actions">
							<span class="topbar-saved v2-saved">@V2Icon("check") Public Docs</span>
							<button type="button" class="v2-copy-url" @click="copyShareURL()" title="Copy public documentation link">@V2Icon("copy") Share Link</button>
							@ThemeSwitch()
						</div>
						<div class="v2-sky" aria-hidden="true"><span class="v2-sun"></span><span class="v2-cloud v2-cloud-one"></span><span class="v2-cloud v2-cloud-two"></span><span class="v2-stars">✧ · ✦ ·</span></div>
					</header>

					<div class="notice v2-toast" role="status" aria-live="polite" x-show="notice" x-cloak @click="notice = ''">
						<span class="v2-toast-dot" aria-hidden="true"></span>
						<span class="v2-toast-text" x-text="notice"></span>
						<button type="button" class="v2-toast-close" aria-label="Dismiss notification" @click.stop="notice = ''">✕</button>
					</div>

					<template x-if="!endpoints.length">
						<section class="empty-state">
							<div class="brand-symbol">⌘</div>
							<h1>No endpoints published yet</h1>
							<p>This workspace does not have any saved API endpoints yet.</p>
						</section>
					</template>

					<template x-if="endpoint">
						<div class="pub-docs-body">
							<section class="endpoint-bar v2-route-toolbar pub-route-toolbar">
								<div class="v2-route-identity">
									<h1><span x-text="endpoint.name"></span></h1>
									<div class="endpoint-title endpoint-readonly v2-route">
										<span class="route-method v2-method" :class="'v2-' + endpoint.method.toLowerCase()" x-text="endpoint.method"></span>
										<code x-text="endpoint.path"></code>
									</div>
								</div>
								<div class="v2-route-actions">
									<div class="base-url v2-base-url" title="Click to copy workspace base URL" @click="copyBaseURL()">
										<span>Base URL:</span>
										<code x-text="baseURL"></code>
									</div>
									<button type="button" class="v2-copy-url" @click="copyEndpointURL()" aria-label="Copy endpoint URL">@V2Icon("copy") Copy URL</button>
									<span class="v2-sample" x-text="scenarios.length + (scenarios.length === 1 ? ' scenario' : ' scenarios')"></span>
									<span class="scenario-status-badge" :class="defaultScenarioRow?.status >= 500 ? 'status-5xx' : defaultScenarioRow?.status >= 400 ? 'status-4xx' : defaultScenarioRow?.status >= 300 ? 'status-3xx' : 'status-2xx'" x-show="defaultScenarioRow" x-text="'Default HTTP ' + (defaultScenarioRow?.status || 200)"></span>
								</div>
							</section>

							<div class="pub-docs-container">

							<!-- Two-Column Layout: Specification & Scenarios (Left) | Interactive Playground (Right) -->
							<div class="pub-docs-grid">
								<!-- Left Column: API Reference & Scenarios -->
								<div class="pub-docs-spec-col">
									<!-- Request Specification Card -->
									<section class="v2-card pub-spec-card">
										<header class="pub-card-header">
											<div>
												<span class="v2-kicker">REQUEST SPECIFICATION</span>
												<h2>Parameters, Headers &amp; Body Example</h2>
											</div>
										</header>

										<!-- Path Parameters -->
										<div class="pub-spec-block" x-show="routeParams.length">
											<h3 class="pub-spec-subtitle">Path Parameters</h3>
											<div class="v2-table-wrap">
												<table class="v2-table pub-param-table">
													<thead>
														<tr>
															<th>PARAMETER</th>
															<th>EXAMPLE VALUE</th>
															<th>REQUIRED</th>
														</tr>
													</thead>
													<tbody>
														<template x-for="param in routeParams" :key="param">
															<tr>
																<td><code class="pub-param-name" x-text="':' + param"></code></td>
																<td><code x-text="requestExample.params?.[param] || '123'"></code></td>
																<td><span class="v2-sample">Required in URL</span></td>
															</tr>
														</template>
													</tbody>
												</table>
											</div>
										</div>

										<!-- Query Parameters -->
										<div class="pub-spec-block" x-show="documentedQueryParams.length">
											<h3 class="pub-spec-subtitle">Query Parameters</h3>
											<div class="v2-table-wrap">
												<table class="v2-table pub-param-table">
													<thead>
														<tr>
															<th>PARAMETER</th>
															<th>EXAMPLE / EXPECTED</th>
														</tr>
													</thead>
													<tbody>
														<template x-for="item in documentedQueryParams" :key="item.key">
															<tr>
																<td><code class="pub-param-name" x-text="item.key"></code></td>
																<td><code x-text="item.value || '(any)'"></code></td>
															</tr>
														</template>
													</tbody>
												</table>
											</div>
										</div>

										<!-- Request Headers -->
										<div class="pub-spec-block" x-show="documentedHeaders.length">
											<h3 class="pub-spec-subtitle">Request Headers</h3>
											<div class="v2-table-wrap">
												<table class="v2-table pub-param-table">
													<thead>
														<tr>
															<th>HEADER</th>
															<th>EXAMPLE / EXPECTED</th>
														</tr>
													</thead>
													<tbody>
														<template x-for="item in documentedHeaders" :key="item.key">
															<tr>
																<td><code class="pub-param-name" x-text="item.key"></code></td>
																<td><code x-text="item.value || '(present)'"></code></td>
															</tr>
														</template>
													</tbody>
												</table>
											</div>
										</div>

										<!-- Request Body Example -->
										<div class="pub-spec-block" x-show="hasBodyExample">
											<div class="pub-spec-subtitle-row">
												<h3 class="pub-spec-subtitle">Request Body Example (<span x-text="requestExample.body_mode === 'form' ? 'Form' : requestExample.body_mode === 'text' ? 'Raw Text' : 'JSON'"></span>)</h3>
												<button type="button" class="v2-btn-action" @click="copyText(formattedExampleBody, 'Request body example copied.')">Copy example</button>
											</div>
											<pre class="pub-code-block" tabindex="0"><code x-text="formattedExampleBody"></code></pre>
										</div>

										<p class="help" x-show="!routeParams.length && !documentedQueryParams.length && !documentedHeaders.length && !hasBodyExample">
											This endpoint accepts standard <span x-text="endpoint.method"></span> requests without required parameters or headers.
										</p>
									</section>

									<!-- Response Scenarios Card -->
									<section class="v2-card pub-scenarios-card">
										<header class="pub-card-header">
											<div>
												<span class="v2-kicker">RESPONSE SCENARIOS</span>
												<h2>Priority Routing &amp; Sample Responses</h2>
											</div>
											<span class="v2-sample" x-text="scenarios.length + (scenarios.length === 1 ? ' path' : ' paths')"></span>
										</header>
										<p class="pub-card-desc">Scenarios are evaluated in priority order (<code class="text-xs">#1</code> first). The first matching condition returns its response; otherwise the <code class="text-xs">Default</code> response is returned.</p>

										<div class="pub-scenario-list">
											<template x-for="row in scenarios" :key="row.key">
												<article class="pub-scenario-item" :class="lastMatchedResponseID && lastMatchedResponseID === row.responseID && 'is-matched'">
													<div class="pub-scenario-head">
														<div class="pub-scenario-title">
															<span class="scenario-order" x-show="!row.isDefault" x-text="'#' + row.priority"></span>
															<span class="default-tag" x-show="row.isDefault">Default</span>
															<strong x-text="row.label"></strong>
														</div>
														<div class="pub-scenario-badges">
															<span class="scenario-status-badge" :class="row.status >= 500 ? 'status-5xx' : row.status >= 400 ? 'status-4xx' : row.status >= 300 ? 'status-3xx' : 'status-2xx'" x-text="'HTTP ' + row.status"></span>
															<span class="scenario-mode-badge" :class="row.responseMode === 'dynamic' ? 'mode-dynamic' : 'mode-static'" x-text="row.responseMode === 'dynamic' ? 'Dynamic JSON' : 'Static JSON'"></span>
															<span class="scenario-delay-badge" x-show="row.delay" x-text="row.delay + ' ms'"></span>
															<button type="button" class="v2-btn-action pub-try-btn" @click="loadScenarioIntoPlayground(row)" title="Load matching inputs into Playground">Try in Playground →</button>
														</div>
													</div>

													<!-- Conditions for this scenario -->
													<div class="pub-scenario-conditions" x-show="row.conditionDetails.length">
														<template x-for="cond in row.conditionDetails" :key="cond.id + ':' + cond.matched">
															<div class="scenario-cond-item" :class="cond.matched ? 'cond-match' : 'cond-nomatch'">
																<div class="scenario-cond-head">
																	<span class="cond-state-dot" x-text="cond.matched ? '◇' : '⊘'"></span>
																	<strong x-text="cond.matched ? 'Matches' : 'Does not match'"></strong>
																	<span class="cond-meta-tag" x-text="cond.meta"></span>
																</div>
																<code class="scenario-condition" x-text="cond.summary"></code>
															</div>
														</template>
													</div>
													<div class="pub-scenario-fallback-note" x-show="row.isDefault">
														<span>Fallback response returned when no condition above matches.</span>
													</div>

													<!-- Response Body Preview -->
													<div class="pub-scenario-body" x-show="row.body">
														<div class="pub-scenario-body-head">
															<span>RESPONSE BODY</span>
															<button type="button" class="text-button text-xs" @click="copyText(formatValue(row.body), 'Scenario response body copied.')">Copy JSON</button>
														</div>
														<pre class="pub-code-block compact" tabindex="0"><code x-text="formatValue(row.body)"></code></pre>
													</div>
												</article>
											</template>
										</div>
									</section>
								</div>

								<!-- Right Column: Interactive Per-API Playground -->
								<div class="pub-docs-play-col">
									<section class="v2-card pub-playground-card" @keydown.ctrl.enter.prevent="sendRequest()" @keydown.meta.enter.prevent="sendRequest()">
										<header class="pub-card-header">
											<div>
												<span class="v2-kicker">LIVE TEST RUNNER</span>
												<h2>API Playground</h2>
											</div>
											<div class="pub-play-actions">
												<button type="button" class="btn text-xs" @click="resetPlayground()" title="Reset inputs to endpoint example">Reset</button>
												<button type="button" class="v2-primary" :disabled="testing" @click="sendRequest()">
													<span x-text="testing ? 'Sending…' : 'Send Request ▶'"></span>
												</button>
											</div>
										</header>

										<!-- Resolved Live Request Preview Bar -->
										<div class="pub-resolved-url-bar">
											<span class="method v2-method" :class="[endpoint.method.toLowerCase(), 'v2-' + endpoint.method.toLowerCase()]" x-text="endpoint.method"></span>
											<code class="pub-resolved-url" x-text="resolvedPlaygroundURL"></code>
											<button type="button" class="base-url-copy-btn" aria-label="Copy resolved request URL" title="Copy resolved URL" @click="copyText(resolvedPlaygroundURL, 'Request URL copied.')">
												<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
											</button>
										</div>

										<!-- Playground Input Tabs -->
										<nav class="scenario-tabs pub-play-tabs" aria-label="Playground request sections">
											<button type="button" :class="playTab === 'params' && 'active'" @click="playTab = 'params'">
												<span>Params</span>
												<span class="scenario-tab-badge" x-show="routeParams.length + playQuery.filter(q => q.key.trim()).length" x-text="routeParams.length + playQuery.filter(q => q.key.trim()).length"></span>
											</button>
											<button type="button" :class="playTab === 'headers' && 'active'" @click="playTab = 'headers'">
												<span>Headers</span>
												<span class="scenario-tab-badge" x-show="playHeaders.filter(h => h.key.trim()).length" x-text="playHeaders.filter(h => h.key.trim()).length"></span>
											</button>
											<button type="button" :class="playTab === 'body' && 'active'" @click="playTab = 'body'">
												<span>Body</span>
												<span class="scenario-tab-badge" x-text="playBodyMode.toUpperCase()"></span>
											</button>
											<button type="button" :class="playTab === 'code' && 'active'" @click="playTab = 'code'">
												<span>cURL / Fetch</span>
											</button>
										</nav>

										<!-- Tab 1: Path & Query Params -->
										<div class="pub-play-tab-body" x-show="playTab === 'params'">
											<div class="pub-play-group" x-show="routeParams.length">
												<div class="field-section-heading">
													<strong>Path Parameters</strong>
												</div>
												<template x-for="param in routeParams" :key="param">
													<div class="pub-kv-row">
														<code class="pub-kv-fixed-key" x-text="':' + param"></code>
														<input class="v2-input" :aria-label="'Path parameter ' + param" x-model="playParams[param]" :placeholder="param + ' value'"/>
													</div>
												</template>
											</div>

											<div class="pub-play-group">
												<div class="field-section-heading">
													<strong>Query Parameters</strong>
													<button type="button" class="text-button" @click="playQuery.push({key: '', value: ''})">+ Query param</button>
												</div>
												<template x-for="(q, idx) in playQuery" :key="idx">
													<div class="header-field-row">
														<input aria-label="Query key" placeholder="page" x-model="q.key"/>
														<input aria-label="Query value" placeholder="1" x-model="q.value"/>
														<button type="button" aria-label="Remove query parameter" @click="playQuery.splice(idx, 1)">✕</button>
													</div>
												</template>
												<p class="help" x-show="!playQuery.length">No query parameters added. Click <strong>+ Query param</strong> to append URL query parameters.</p>
											</div>
										</div>

										<!-- Tab 2: Request Headers -->
										<div class="pub-play-tab-body" x-show="playTab === 'headers'">
											<div class="field-section-heading">
												<strong>Request Headers</strong>
												<button type="button" class="text-button" @click="playHeaders.push({key: '', value: ''})">+ Header</button>
											</div>
											<template x-for="(h, idx) in playHeaders" :key="idx">
												<div class="header-field-row">
													<input aria-label="Header name" placeholder="Authorization" x-model="h.key"/>
													<input aria-label="Header value" placeholder="Bearer token" x-model="h.value"/>
													<button type="button" aria-label="Remove header" @click="playHeaders.splice(idx, 1)">✕</button>
												</div>
											</template>
											<p class="help" x-show="!playHeaders.length">No custom headers set. Click <strong>+ Header</strong> to add request headers.</p>
										</div>

										<!-- Tab 3: Request Body -->
										<div class="pub-play-tab-body" x-show="playTab === 'body'">
											<div class="pub-body-mode-row">
												<label for="pub-play-body-mode" class="v2-label">Payload format</label>
												<select id="pub-play-body-mode" class="v2-select" x-model="playBodyMode">
													<option value="json">Raw JSON</option>
													<option value="form">Form fields (JSON map)</option>
													<option value="text">Raw Text</option>
												</select>
											</div>
											<textarea x-show="playBodyMode === 'json'" class="code-editor" aria-label="JSON request body" spellcheck="false" x-model="playBodyJSON" placeholder='{"key": "value"}'></textarea>
											<textarea x-show="playBodyMode === 'form'" class="code-editor" aria-label="Form fields JSON" spellcheck="false" x-model="playBodyForm" placeholder='{"email": ["user@example.com"]}'></textarea>
											<textarea x-show="playBodyMode === 'text'" class="code-editor" aria-label="Raw text request body" spellcheck="false" x-model="playBodyText" placeholder="Raw request payload"></textarea>
										</div>

										<!-- Tab 4: Ready-to-run cURL & Fetch Snippets -->
										<div class="pub-play-tab-body" x-show="playTab === 'code'">
											<div class="pub-snippet-group">
												<div class="field-section-heading">
													<strong>cURL Command</strong>
													<button type="button" class="text-button" @click="copyText(curlSnippet, 'cURL command copied.')">Copy cURL</button>
												</div>
												<pre class="pub-code-block compact" tabindex="0"><code x-text="curlSnippet"></code></pre>
											</div>
											<div class="pub-snippet-group mt-3">
												<div class="field-section-heading">
													<strong>JavaScript fetch()</strong>
													<button type="button" class="text-button" @click="copyText(fetchSnippet, 'JavaScript fetch snippet copied.')">Copy fetch()</button>
												</div>
												<pre class="pub-code-block compact" tabindex="0"><code x-text="fetchSnippet"></code></pre>
											</div>
										</div>

										<p class="dialog-error" role="alert" x-show="playError" x-text="playError"></p>

										<!-- Live Response Output -->
										<div class="pub-response-panel">
											<div class="pub-response-head">
												<span class="v2-kicker">RESPONSE OUTPUT</span>
												<div class="pub-response-badges" x-show="testResult">
													<span class="scenario-status-badge" :class="testResult?.status >= 500 ? 'status-5xx' : testResult?.status >= 400 ? 'status-4xx' : testResult?.status >= 300 ? 'status-3xx' : 'status-2xx'" x-text="testResult ? 'HTTP ' + testResult.status : ''"></span>
													<span class="scenario-delay-badge" x-show="testResult?.duration_ms !== undefined" x-text="(testResult?.duration_ms || 0) + ' ms'"></span>
													<span class="v2-sample" x-show="matchedScenarioLabel" x-text="matchedScenarioLabel"></span>
													<button type="button" class="text-button text-xs" @click="copyText(formatValue(testResult?.body || ''), 'Response body copied.')">Copy body</button>
												</div>
											</div>

											<template x-if="testResult">
												<div class="pub-response-content">
													<pre class="response-output pub-response-pre" tabindex="0" x-text="formatValue(testResult.body)"></pre>

													<!-- Response Headers -->
													<details class="pub-response-details" x-show="testResult.headers && Object.keys(testResult.headers).length">
														<summary>Response Headers (<span x-text="Object.keys(testResult.headers || {}).length"></span>)</summary>
														<div class="pub-headers-kv">
															<template x-for="[hk, hv] in Object.entries(testResult.headers || {})" :key="hk">
																<div class="pub-header-kv-item">
																	<code x-text="hk"></code>
																	<span x-text="hv"></span>
																</div>
															</template>
														</div>
													</details>

													<!-- Condition Evaluation Diagnostics -->
													<details class="pub-response-details" x-show="testResult.conditions?.length">
														<summary>Scenario Condition Evaluation (<span x-text="testResult.conditions?.length || 0"></span>)</summary>
														<div class="condition-test-report">
															<template x-for="(check, idx) in testResult.conditions || []" :key="check.id">
																<div class="condition-test-check">
																	<strong x-text="'#' + (idx + 1) + ' ' + check.label"></strong>
																	<span class="type-pill v2-sample" x-text="check.evaluated ? (check.matched ? 'Matched' : 'Not matched') : 'Not visited'"></span>
																	<p x-text="check.reason"></p>
																</div>
															</template>
														</div>
													</details>
												</div>
											</template>

											<template x-if="!testResult">
												<div class="pub-response-empty">
													<p>Click <strong>Send Request ▶</strong> (or press <kbd>Ctrl+Enter</kbd>) to execute this API endpoint and inspect the live response and scenario routing.</p>
												</div>
											</template>
										</div>
									</section>
								</div>
							</div>
							</div>
						</div>
					</template>
				</main>
			</div>
		</body>
	</html>
}

templ PublicDocsDisabledPage(slug string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>Public API Docs Unavailable — Mocklab</title>
			<script>try { const value=localStorage.getItem('mocklab-theme'); document.documentElement.dataset.theme=value==='night'||!['light','night'].includes(value)&&matchMedia('(prefers-color-scheme: dark)').matches?'night':'light'; } catch { document.documentElement.dataset.theme='light'; }</script>
			<link rel="stylesheet" href="/assets/app.css"/>
		</head>
		<body>
			<main class="empty-state" style="min-height: 100vh">
				<div class="brand-symbol">☁</div>
				<h1>Public API documentation unavailable</h1>
				<p>The workspace <code>{ slug }</code> either does not exist or its owner has turned off public viewer access.</p>
				<a href="/app" class="btn primary">Sign in to Mocklab ↗</a>
			</main>
		</body>
	</html>
}
