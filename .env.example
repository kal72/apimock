ADDR=127.0.0.1:8080
DATABASE_URL=postgres://mocklab:mocklab@127.0.0.1:5432/mocklab?sslmode=disable
APP_ENV=development
# Optional public origin. Leave empty to use the browser's current origin.
PUBLIC_BASE_URL=
# Set both values to enable administrator Basic authentication, including locally.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Exact origins separated by commas. Empty allows same-origin requests only.
# Use * alone for public mock access without browser credentials.
MOCK_CORS_ORIGINS=
MOCK_CORS_HEADERS=Content-Type,Authorization,X-Api-Key
