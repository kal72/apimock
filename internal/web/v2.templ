package web

import "strings"

templ V2Page(page string) {
 <!DOCTYPE html>
 <html lang="en">
 <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Mocklab V2 — Design preview</title><link rel="stylesheet" href="/assets/app.css"/><script type="module" src="/assets/app.js"></script></head>
 <body class="v2-body">
 <div class="v2" x-data="{ night: false, table: false, tab: 'General', environment: 'Development', inspector: false, notice: '', zoom: 1, tested: false }" :class="night && 'v2-night'">
  @V2Sidebar(page)
  <main class="v2-main">
   @V2Header(page)
   
   <div class="v2-notice" x-show="notice" x-cloak role="status"><span x-text="notice"></span><button @click="notice = ''" aria-label="Dismiss notification">×</button></div>
   switch page {
    case "endpoints":
     @V2Endpoints()
    case "environments":
     @V2Environments()
    case "mocks":
     @V2Mocks()
    case "logs":
     @V2Logs()
    case "settings":
     @V2Settings()
   }
   <footer class="v2-footer"><span>MOCKLAB / Graphite Blue + Cloudline</span><span>V2 · Sample data only · <a href="/app">Return to current app ↗</a></span></footer>
  </main>
  <div class="v2-overlay" x-show="inspector" x-cloak @click.self="inspector = false" @keydown.escape.window="inspector = false">
   <section class="v2-dialog" role="dialog" aria-modal="true" aria-label="Condition preview" x-trap.inert.noscroll="inspector"><header><h2>Edit condition</h2><button @click="inspector = false" aria-label="Close condition preview">×</button></header><p>Preview form · changes are not saved.</p><label>Name<input value="Product found"/></label><label>Source<select><option>Path params</option><option>Headers</option><option>Query params</option><option>Body</option></select></label><div class="v2-form-grid"><label>Field<input value="id"/></label><label>Operator<select><option>Equals</option><option>Required</option></select></label></div><label>Value<input value="123"/></label><label class="v2-check"><input type="checkbox" checked/> Required</label><button class="v2-primary" @click="inspector = false; notice = 'Preview closed. No configuration was saved.'">Done</button></section>
  </div>
 </div>
 </body></html>
}

templ V2Sidebar(page string) {
 <aside class="v2-sidebar"><a class="v2-brand" href="/app/v2"><span>☁</span> mocklab<span class="v2-version">V2</span></a><label class="v2-kicker" for="v2-workspace">WORKSPACE</label><select id="v2-workspace"><option>Commerce API</option></select><nav aria-label="V2 navigation">
 for _, item := range []struct{ key, icon, label string }{{"endpoints","⌘","Endpoints"},{"environments","◈","Environments"},{"mocks","⬡","Mocks"},{"logs","≡","Logs"},{"settings","⚙","Settings"}} {
  <a href={ templ.SafeURL("/app/v2/"+item.key) } class={ templ.KV("v2-active",page==item.key) } aria-current={ map[bool]string{true:"page",false:"false"}[page==item.key] }><span>{ item.icon }</span>{ item.label }</a>
 }
 </nav>
 if page == "endpoints" {
 @V2EndpointList()
 }
 <div class="v2-sidebar-note"><span class="v2-kicker">DESIGN SANDBOX</span><p>Build before the backend.<br/>One workspace. Endless possibilities.</p><span class="v2-sample">Sample workspace</span></div></aside>
}

templ V2Header(page string) {
 <header class="v2-header">
  <nav class="v2-breadcrumb" aria-label="Breadcrumb">
   <a href="/app/v2" aria-label="V2 home">@V2Icon("home")</a><span>›</span>
   <a href="/app/v2/mocks">Commerce API</a><span>›</span>
   <a href={ templ.SafeURL("/app/v2/"+page) }>{ strings.ToUpper(page[:1])+page[1:] }</a>
   if page == "endpoints" {
 <span>›</span><span class="v2-header-endpoint"><b class="v2-method">GET</b><code>/products/:id</code></span>
 }
  </nav>
  <div class="v2-header-actions">
   <span class="v2-saved" title="Static preview status">@V2Icon("check") Saved</span>
   <button class="v2-theme" role="switch" :aria-checked="night" @click="night = !night" aria-label="Night theme"><span class="v2-theme-sun">@V2Icon("sun")</span><span class="v2-theme-moon">@V2Icon("moon")</span></button>
   <span class="v2-header-divider" aria-hidden="true"></span>
   <div class="v2-account-wrap" x-data="{ accountOpen: false }" @click.outside="accountOpen = false" @keydown.escape.window="accountOpen = false">
    <button class="v2-account" @click="accountOpen = !accountOpen" :aria-expanded="accountOpen" aria-controls="v2-account-menu">@V2Icon("user")<span>Alex</span><span class="v2-chevron">⌄</span></button>
    <div class="v2-account-menu" id="v2-account-menu" x-show="accountOpen" x-cloak><strong>Alex Morgan</strong><small>Owner · Sample account</small><a href="/app/v2/settings">Workspace settings</a><a href="/app">Return to current app ↗</a></div>
   </div>
  </div>
  <div class="v2-sky" aria-hidden="true"><span class="v2-sun"></span><span class="v2-cloud v2-cloud-one"></span><span class="v2-cloud v2-cloud-two"></span><span class="v2-stars">✧ · ✦ ·</span></div>
 </header>
}

templ V2Icon(name string) {
 <svg class="v2-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
 switch name {
 case "home":
  <path d="m3 10 9-7 9 7M5 9v11h5v-7h4v7h5V9"></path>
 case "check":
  <path d="m5 12 4 4L19 6"></path>
 case "sun":
  <circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
 case "moon":
  <path d="M20 15.4A9 9 0 0 1 8.6 4 9 9 0 1 0 20 15.4Z"></path>
 case "user":
  <circle cx="12" cy="8" r="3.2"></circle><path d="M5 20v-2a7 7 0 0 1 14 0v2Z"></path>
 case "copy":
  <rect x="8" y="8" width="12" height="13" rx="2"></rect><path d="M16 8V3H3v13h5"></path>
 }
 </svg>
}

templ V2Title(title, subtitle string) {
 <div class="v2-title"><div><span class="v2-kicker">COMMERCE API</span><h1>{ title }</h1><p>{ subtitle }</p></div></div>
}

templ V2Node(kind, title, subtitle, position string) {
 <article class={ "v2-node", "v2-node-"+kind, "v2-position-"+position }><div class="v2-node-top"><span class="v2-node-icon">{ map[string]string{"incoming":"↪","condition":"◇","response":"⌘","default":"!"}[kind] }</span><strong>{ title }</strong><button @click="inspector = true" aria-label={ "Edit "+title }>✎</button></div><p>{ subtitle }</p><span class="v2-port v2-port-in"></span><span class="v2-port v2-port-out"></span></article>
}

templ V2Endpoints() {
 <div class="v2-editor-layout">
 <div class="v2-editor"><section class="v2-route-toolbar"><div><h1>Get product <span>✎</span></h1><div class="v2-route"><span class="v2-method">GET</span><code>/products/:id</code></div></div><div class="v2-route-actions"><div class="v2-base-url"><span>Base URL:</span><code>http://localhost:18080/public/commerce</code></div><button class="v2-copy-url" @click="notice = 'Example URL: /public/commerce/products/123'">@V2Icon("copy") Copy URL</button><div class="v2-segment"><button :class="!table && 'selected'" @click="table = false">⌘ Node</button><button :class="table && 'selected'" @click="table = true">▤ Table</button></div></div></section>
 <section class="v2-canvas-panel" x-show="!table"><header><strong>Visual flow <span class="v2-sample">First match wins</span></strong><button @click="notice = 'Choose Header, Query, Body or Path params · Preview only.'">+ Add condition</button></header><div class="v2-canvas"><div class="v2-graph" :style="'transform: scale(' + zoom + ')'">
 <svg class="v2-connections" viewBox="0 0 1040 450" aria-label="Incoming request connects to two conditions and a default response"><defs><marker id="v2-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 1 1 L 9 5 L 1 9" fill="none" stroke="currentColor" stroke-width="1.5"></path></marker></defs><path d="M 250 220 C 320 220 320 100 395 100"/><path d="M 250 220 C 320 220 320 240 395 240"/><path d="M 250 220 C 410 220 440 380 775 380"/><path d="M 635 100 L 775 100"/><path d="M 635 240 L 775 240"/><text x="660" y="85">Match</text><text x="660" y="225">Match</text><text x="560" y="360">Default</text></svg>
 @V2Node("incoming","Incoming request","GET /products/:id","incoming")
 <span class="v2-priority v2-priority-one">Priority #1</span>@V2Node("condition","Product found","Path · id equals 123","one")
 <span class="v2-priority v2-priority-two">Priority #2</span>@V2Node("condition","Invalid ID","Path · id is empty","two")
 @V2Node("response","Response: 200 OK","Return product details","success")
 @V2Node("response","Response: 400 Bad Request","The product ID is invalid","error")
 @V2Node("default","Default response","404 Not Found · Always last","default")
 </div></div><footer><span>Drag and connection editing will be connected during migration.</span><div class="v2-zoom"><button @click="zoom = Math.max(0.5, zoom - 0.25)" :disabled="zoom <= 0.5" aria-label="Zoom out">−</button><button @click="zoom = 1" x-text="Math.round(zoom * 100) + '%'" aria-label="Reset zoom"></button><button @click="zoom = Math.min(1.5, zoom + 0.25)" :disabled="zoom >= 1.5" aria-label="Zoom in">+</button></div></footer></section>
 <section class="v2-card" x-show="table" x-cloak><h2>Response scenarios</h2>@V2ScenarioTable()</section>
 <section class="v2-playground"><div><header><h2>⌁ Request playground</h2><span class="v2-sample">Sample execution</span></header><div class="v2-run"><span class="v2-method">GET</span><input aria-label="Sample request URL" value="/public/commerce/products/123"/><button class="v2-primary" @click="tested = true">▶ Run request</button></div></div><div class="v2-result"><header><h2>Response <span class="v2-method" x-show="tested">200 OK</span></h2><small>Static preview</small></header><pre x-show="tested">{ `{ "id": 123,
  "name": "Wireless headphones",
  "price": 99.99 }` }</pre><p x-show="!tested">Run the sample to preview a formatted response.</p></div></section>
 </div></div>
}

templ V2ScenarioTable() {
 <div class="v2-table-wrap"><table><thead><tr><th>Priority</th><th>Request path</th><th>Conditions</th><th>Response</th><th>Action</th></tr></thead><tbody><tr><td>#1</td><td>GET /products/:id</td><td>Path · id equals 123</td><td>200 OK</td><td><button @click="inspector = true">Edit ↗</button></td></tr><tr><td>#2</td><td>GET /products/:id</td><td>Path · id is empty</td><td>400 Bad Request</td><td><button @click="inspector = true">Edit ↗</button></td></tr><tr><td>Default</td><td>GET /products/:id</td><td>When no condition matches</td><td>404 Not Found</td><td><button @click="inspector = true">Edit ↗</button></td></tr></tbody></table></div>
}

templ V2Environments() {
 <div class="v2-content">@V2Title("Environments","Define reusable values for each stage of development.")<div class="v2-environments">
 for _, name := range []string{"Development","Staging","Production"} {
 <button class="v2-env-card" :class={ "environment === '"+name+"' && 'selected'" } @click={ "environment = '"+name+"'" }><span>◈</span><strong>{ name }</strong><small>Sample environment</small></button>
 }
 </div><div class="v2-split"><section class="v2-card"><header><h2>Variables <span class="v2-sample" x-text="environment"></span></h2><button @click="notice = 'Variable creation is a visual placeholder.'">+ Add variable</button></header><p class="v2-info">Preview values only. Public mock behavior is unchanged.</p><div class="v2-table-wrap"><table><thead><tr><th>Key</th><th>Value</th><th>Type</th><th>Action</th></tr></thead><tbody>
 for _, row := range [][]string{{"api_url","/public/commerce","String"},{"currency","USD","String"},{"delay_ms","150","Number"},{"feature_enabled","true","Boolean"},{"demo_token","••••••••","Secret"}} {
 <tr><td><code>{ row[0] }</code></td><td>{ row[1] }</td><td><span class="v2-sample">{ row[2] }</span></td><td><button @click="notice = 'Use the sample variable form on the right.'">Edit</button></td></tr>
 }
 </tbody></table></div><footer>5 sample variables</footer></section><section class="v2-card"><h2>Edit variable</h2><p>Changes are local to this preview.</p><label>Key<input value="currency"/></label><label>Value<input value="USD"/></label><label>Type<select><option>String</option><option>Number</option><option>Boolean</option><option>Secret</option></select></label><button class="v2-primary" @click="notice = 'Preview only. No variable was saved.'">Save variable</button></section></div></div>
}

templ V2Mocks() {
 <div class="v2-content">@V2Title("Mocks","Manage callable REST mocks across your workspace.")<div class="v2-stats"><div><span>ENDPOINTS</span><strong>12</strong><small>Across this workspace</small></div><div><span>ENABLED</span><strong>10</strong><small>Ready for requests</small></div><div><span>CONDITIONS</span><strong>24</strong><small>Priority-based scenarios</small></div></div><section class="v2-card"><header><div><h2>Workspace mocks</h2><p>Base URL · /public/commerce</p></div><a class="v2-primary" href="/app/v2/endpoints">+ New endpoint</a></header><div class="v2-filters"><input placeholder="Search mocks…" aria-label="Search sample mocks" @input="notice = 'Search is a visual placeholder.'"/><select aria-label="Sample method filter"><option>All methods</option><option>GET</option><option>POST</option></select></div><div class="v2-table-wrap"><table><thead><tr><th>Name / Path</th><th>Method</th><th>Scenarios</th><th>Response mode</th><th>Status</th><th>Action</th></tr></thead><tbody>
 for _, row := range [][]string{{"Get product","/products/:id","GET","3","Dynamic JSON"},{"Create product","/products","POST","2","Static JSON"},{"List orders","/orders","GET","4","Dynamic JSON"},{"Health check","/health","GET","1","Static JSON"}} {
 <tr><td><strong>{ row[0] }</strong><code class="v2-block">{ row[1] }</code></td><td><span class="v2-method">{ row[2] }</span></td><td>{ row[3] }</td><td>{ row[4] }</td><td><span class="v2-status">● Enabled</span></td><td><a class="v2-button" href="/app/v2/endpoints">Open flow ↗</a></td></tr>
 }
 </tbody></table></div><footer>Showing 4 sample mocks · Counts are illustrative</footer></section></div>
}

templ V2Logs() {
 <div class="v2-content">@V2Title("Request logs","Inspect incoming requests and follow their response path.")<div class="v2-split"><section class="v2-card"><header><h2>Recent requests</h2><span class="v2-status">● Sample stream</span></header><div class="v2-filters"><input placeholder="Search path or request ID…" aria-label="Search sample logs" @input="notice = 'Log search is a visual placeholder.'"/><select aria-label="Time range"><option>Last 30 minutes</option><option>Last 24 hours</option></select></div><div class="v2-table-wrap"><table><thead><tr><th>Time</th><th>Method</th><th>Path</th><th>Status</th><th>Duration</th></tr></thead><tbody>
 for _, row := range [][]string{{"14:32:08","GET","/products/123","200","12 ms"},{"14:32:02","GET","/products/invalid","400","8 ms"},{"14:31:58","GET","/products/999","404","9 ms"},{"14:31:51","POST","/products","201","16 ms"},{"14:31:44","GET","/orders","200","18 ms"}} {
 <tr><td>{ row[0] }</td><td><span class="v2-method">{ row[1] }</span></td><td><code>{ row[2] }</code></td><td>{ row[3] }</td><td>{ row[4] }</td></tr>
 }
 </tbody></table></div><footer>5 sample requests · No request history is collected here</footer></section><section class="v2-card"><header><h2>GET /products/123</h2><span class="v2-method">200 OK</span></header><p>Request ID · req_8f21</p><div class="v2-trace"><div><span>↪</span><strong>Incoming request</strong><small>GET /products/123</small></div><div><span>◇</span><strong>Condition #1 · Product found</strong><small>Matched · id equals 123</small></div><div><span>✓</span><strong>Response · 200 OK</strong><small>Default was not evaluated</small></div></div><h3>Response body</h3><pre>{ `{ "id": 123,
  "name": "Wireless headphones",
  "price": 99.99 }` }</pre><a class="v2-button v2-block" href="/app/v2/endpoints">Open in Node editor ↗</a></section></div></div>
}

templ V2Settings() {
 <div class="v2-content">@V2Title("Workspace settings","Manage workspace details, access and mock defaults.")<div class="v2-tabs">
 for _, name := range []string{"General","Members","Mock defaults"} {
 <button :class={ "tab === '"+name+"' && 'selected'" } @click={ "tab = '"+name+"'" }>{ name }</button>
 }
 </div><div x-show="tab === 'General'" class="v2-split"><section class="v2-card"><h2>Workspace details</h2><label>Workspace name<input value="Commerce API"/></label><label>Workspace slug<input value="commerce"/></label><p>Changing the slug would change all public mock URLs.</p><label>Public base URL<input value="http://localhost:18080/public/commerce" readonly/></label><label>Description<textarea>Mock APIs for storefront integration.</textarea></label><button class="v2-primary" @click="notice = 'Preview only. No workspace changes were saved.'">Save changes</button></section><div class="v2-stack"><section class="v2-card"><h2>Access summary</h2><dl><dt>Your role</dt><dd>Owner</dd><dt>Owner</dt><dd>Alex Morgan</dd><dt>Members</dt><dd>3</dd></dl><button @click="tab = 'Members'">Manage members ↗</button></section><section class="v2-card v2-danger"><h2>Danger zone</h2><p>Workspace deletion is disabled in this design preview.</p><button disabled>Delete workspace</button></section></div></div><section class="v2-card" x-show="tab === 'Members'" x-cloak><header><h2>Workspace members</h2><button @click="notice = 'Member invitations are a visual placeholder.'">+ Add member</button></header><div class="v2-table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th></tr></thead><tbody>
 for _, row := range [][]string{{"Alex Morgan","alex@example.test","Owner"},{"Jamie Lee","jamie@example.test","Editor"},{"Taylor Reed","taylor@example.test","Viewer"}} {
 <tr><td>{ row[0] }</td><td>{ row[1] }</td><td><span class="v2-sample">{ row[2] }</span></td></tr>
 }
 </tbody></table></div></section><section class="v2-card v2-defaults" x-show="tab === 'Mock defaults'" x-cloak><h2>Mock defaults</h2><label>Default environment<select><option>Development</option><option>Staging</option><option>Production</option></select></label><label>Response format<select><option>JSON</option></select></label><label>Default latency (ms)<input type="number" value="0" min="0"/></label><button class="v2-primary" @click="notice = 'Preview only. No mock defaults were saved.'">Save defaults</button></section></div>
}


templ V2EndpointList() {
 <section class="v2-endpoint-list"><header><strong>Endpoints <small>3</small></strong><button @click="notice = 'Endpoint creation is a visual placeholder.'" aria-label="Add sample endpoint">+</button></header><input placeholder="Search endpoints…" aria-label="Search sample endpoints" @input="notice = 'Search is a visual placeholder in this template.'"/><button class="v2-endpoint-selected"><b class="v2-method">GET</b> /products/:id</button><button @click="notice = 'Sample endpoint · POST /products'"><b class="v2-method v2-post">POST</b> /products</button><button @click="notice = 'Sample endpoint · GET /orders'"><b class="v2-method">GET</b> /orders</button><div class="v2-list-bottom">3 endpoints · Sample data</div></section>
}
