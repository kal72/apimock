package web

templ Page() {
 <!DOCTYPE html>
 <html lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Mocklab — API workspace</title>
  <script>
   try { const value = localStorage.getItem('mocklab-theme'); const night = value === 'night' || !['light','night'].includes(value) && matchMedia('(prefers-color-scheme: dark)').matches; document.documentElement.dataset.theme = night ? 'night' : 'light'; document.documentElement.style.colorScheme = night ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'light'; }
  </script>
  <link rel="stylesheet" href="/assets/app.css"/>
  <script type="module" src="/assets/app.js"></script>
 </head>
 <body>
  <div class="app-shell" x-data="mocklab" x-init="boot()" @keydown.escape.window="modal = null; connecting = null" @keydown.ctrl.s.window.prevent="!modal && readyToSave && saveEndpoint()" @keydown.meta.s.window.prevent="!modal && readyToSave && saveEndpoint()">
   @Sidebar()
   <main class="min-w-0 flex flex-col">
    @Toolbar()
    <div class="notice" role="status" x-show="notice" x-cloak x-text="notice"></div>
    <template x-if="!workspace">
     <section class="empty-state"><div class="brand-symbol">m</div><h1>Your next API starts here.</h1><p>Create a workspace to design, test, and run REST API mocks.</p><button class="btn primary" @click="openWorkspace()">+ Create workspace</button></section>
    </template>
    <template x-if="workspace && !endpoint">
     <section class="empty-state"><span class="eyebrow">WORKSPACE READY</span><h1>Give your ideas an endpoint.</h1><p x-text="canEditWorkspace ? 'Start with a simple response, then add logic in the visual editor.' : 'No endpoints yet. Ask an editor or owner to add one.'"></p><button x-show="canEditWorkspace" class="btn primary" @click="newEndpoint()">+ Add endpoint</button></section>
    </template>
    <template x-if="endpoint">
     <div class="editor-shell">
      @EndpointBar()
      @FlowValidation()
      @FlowCanvas()
      @TableEditor()
      @SaveBar()
      @TestPanel()
     </div>
    </template>
    <footer><span>MOCKLAB <span class="text-slate-400">/ local workspace</span></span><span hx-get="/app/status" hx-trigger="load, every 30s" hx-swap="innerHTML">Connecting…</span></footer>
   </main>
   @Dialogs()
  </div>
 </body>
 </html>
}

templ Sidebar() {
 <aside class="sidebar">
  <a href="/app" class="brand"><span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M9 24h15a6 6 0 0 0 .4-12A9 9 0 0 0 7 11a6.6 6.6 0 0 0 2 13Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m13 15-3 3 3 3m6-6 3 3-3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>mocklab<span class="brand-period">.</span></span><span class="badge">BETA</span></a>
  <div class="sidebar-label">WORKSPACE <button aria-label="Add workspace" @click="openWorkspace()">+</button></div>
  @WorkspaceSwitcher()
  <div class="workspace-url" x-show="workspace" x-cloak><span class="eyebrow">BASE URL</span><code x-text="baseURL"></code><button class="text-button" @click="copyBaseURL()">Copy base URL ↗</button></div>
  <div class="sidebar-label mt-8">ENDPOINTS <span x-text="endpoints.length"></span></div>
  <input class="search-input" placeholder="Search endpoints…" aria-label="Search endpoints" x-model="search"/>
  <nav class="endpoint-list"><template x-for="e in filteredEndpoints" :key="e.id"><button class="endpoint-link" :class="endpoint?.id === e.id ? 'active' : ''" @click="selectEndpoint(e)"><span class="method" :class="e.method.toLowerCase()" x-text="e.method"></span><span class="truncate" x-text="e.path"></span></button></template></nav>
  <button class="add-endpoint" :disabled="!workspace || !canEditWorkspace" @click="newEndpoint()">+ Add endpoint</button>
  <a class="generator-reference-link" href="/docs/generators" target="_blank" rel="noopener">Generator reference ↗</a>
  <div class="sidebar-bottom"><span class="mini-icon">◇</span><div><strong>Build before the backend.</strong><p>One workspace. Endless possibilities.</p></div></div>
 </aside>
}

templ WorkspaceSwitcher() {
 <div class="workspace-picker" @keydown.escape.stop.prevent="workspaceMenuOpen=false; $refs.workspaceSettings?.focus()" @click.outside="workspaceMenuOpen=false" @focusout="if (!$el.contains($event.relatedTarget)) workspaceMenuOpen=false">
  <div class="workspace-picker-row"><select class="workspace-select" aria-label="Select workspace" x-model="workspaceID" @change="workspaceMenuOpen=false; selectWorkspace(workspaceID)"><option value="">Select workspace</option><template x-for="w in workspaces" :key="w.id"><option :value="w.id" x-text="w.name"></option></template></select><button class="workspace-settings-trigger" x-show="workspace &amp;&amp; canManageWorkspace" x-cloak x-ref="workspaceSettings" aria-label="Workspace settings" title="Workspace settings" aria-controls="workspace-settings-panel" :aria-expanded="workspaceMenuOpen" @click="workspaceMenuOpen=!workspaceMenuOpen" @keydown.arrow-down.prevent="workspaceMenuOpen=true; $nextTick(()=>$refs.workspaceEdit.focus())"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" stroke="currentColor" stroke-width="1.5"/><path d="m9 3-.6 2-2 .9-2-.5-2 3.4 1.4 1.5v2.4L2.4 14l2 3.4 2-.5 2 .9.6 2h4l.6-2 2-.9 2 .5 2-3.4-1.4-1.3v-2.4l1.4-1.5-2-3.4-2 .5-2-.9-.6-2H9Z" transform="translate(1 1)" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></button></div>
  <div class="workspace-access" x-show="workspace" x-cloak><span>Your access</span><strong x-text="workspace?.role"></strong></div>
  <div class="workspace-settings-panel" id="workspace-settings-panel" x-show="workspaceMenuOpen &amp;&amp; canManageWorkspace" x-cloak>
   <div class="workspace-settings-heading"><span>WORKSPACE SETTINGS</span><strong x-text="workspace?.name"></strong></div>
   <div class="workspace-settings-actions"><button x-ref="workspaceEdit" @click="workspaceMenuOpen=false; openWorkspace(workspace)"><span aria-hidden="true">✎</span><span>Edit workspace<small>Name and base path</small></span></button><button @click="workspaceMenuOpen=false; openMembers()"><span aria-hidden="true">♙</span><span>Manage members<small>People and access roles</small></span></button></div>
   <button class="workspace-delete-action" @click="workspaceMenuOpen=false; removeWorkspace()"><span aria-hidden="true">⌫</span><span>Delete workspace<small>Remove all endpoints</small></span></button>
  </div>
 </div>
}

templ Toolbar() {
 <header class="toolbar" x-data="{accountOpen:false}" @keydown.escape.stop="accountOpen=false; $refs.accountTrigger?.focus()">
  <div class="breadcrumbs"><span>Workspaces</span><span>/</span><strong x-text="workspace?.name || 'Overview'"></strong><span class="unsaved" x-show="dirty && canEditWorkspace" x-cloak>Unsaved</span></div>
  <div class="topbar-actions">
   @ThemeSwitch()
   <span class="topbar-saved" x-show="endpoint && !dirty" x-cloak><span aria-hidden="true">✓</span> Saved</span>
   <button class="btn primary" x-show="dirty && canEditWorkspace" x-cloak :disabled="!readyToSave" @click="saveEndpoint()" x-text="busy ? 'Saving…' : 'Save changes'"></button>
   <div class="account-popover" x-show="currentUser" x-cloak @click.outside="accountOpen=false">
    <button class="account-trigger" x-ref="accountTrigger" aria-label="Account settings" aria-controls="account-settings-panel" :aria-expanded="accountOpen" @click="accountOpen=!accountOpen" @keydown.arrow-down.prevent="accountOpen=true; $nextTick(()=>(currentUser?.role === 'admin' ? $refs.userAction : $refs.passwordAction).focus())"><span class="account-avatar" x-text="currentUser?.name?.slice(0,1).toUpperCase() || '?'"></span><span class="account-first-name" x-text="currentUser?.name?.trim().split(/\s+/)[0] || 'Account'"></span><span class="account-chevron" aria-hidden="true">⌄</span></button>
    <section id="account-settings-panel" class="account-settings-panel" aria-label="Account settings" x-show="accountOpen" x-cloak x-transition.opacity.duration.100ms>
     <div class="account-panel-heading"><div><strong x-text="currentUser?.name"></strong><span x-text="'@' + (currentUser?.username || '')"></span></div><span class="type-pill" x-text="currentUser?.role"></span></div>

     <div class="account-panel-actions"><button x-ref="userAction" x-show="currentUser?.role === 'admin'" @click="accountOpen=false; openUsers()"><span aria-hidden="true">♙</span> User management</button><button x-ref="passwordAction" @click="accountOpen=false; openPassword()"><span aria-hidden="true">⚿</span> Change password</button></div>
     <button class="account-signout" @click="accountOpen=false; logout()"><span aria-hidden="true">↪</span> Sign out</button>
    </section>
   </div>
  </div>
 </header>
}

templ EndpointBar() {
 <section class="endpoint-bar"><div><span class="eyebrow">ENDPOINT EDITOR</span><div class="endpoint-title endpoint-readonly"><span class="route-method" x-text="endpoint.method"></span><code x-text="endpoint.path"></code></div><div class="base-url"><span>BASE URL</span><code x-text="baseURL"></code><button @click="copyBaseURL()" aria-label="Copy base URL">Copy base URL ↗</button><button @click="copyURL()" aria-label="Copy endpoint URL">Copy endpoint ↗</button></div></div><div class="flex gap-2 items-center"><div class="view-switch"><button :class="mode === 'node' && 'selected'" @click="mode = 'node'">◇ Node</button><button :class="mode === 'table' && 'selected'" @click="mode = 'table'">▤ Table</button></div><button x-show="canEditWorkspace" class="btn danger-quiet" @click="removeEndpoint()" aria-label="Delete endpoint">Delete</button></div></section>
}

templ SaveBar() {
 <div class="editor-save-bar" x-show="dirty && canEditWorkspace" x-cloak><div><strong>Changes are still a draft</strong><span>Test the response, then save to update the mock API.</span></div><div class="save-bar-actions"><button class="text-button" x-show="undoSnapshot && canEditWorkspace" @click="undoChange()" :disabled="busy">Undo last change</button><button x-show="canEditWorkspace" class="btn" @click="discardChanges()" :disabled="busy">Discard draft</button><button x-show="canEditWorkspace" class="btn primary" @click="saveEndpoint()" :disabled="!readyToSave" x-text="busy ? 'Saving…' : 'Save &amp; activate'"></button></div></div>
}

templ FlowValidation() {
 <details class="condition-warning" x-show="conditionWarnings.length" x-cloak><summary><strong>Review condition priority</strong> · <span x-text="conditionWarnings.length + ' warnings'"></span></summary><span>Warnings do not block saving. The first matching condition wins; default stays last.</span><template x-for="warning in conditionWarnings" :key="warning"><p x-text="warning"></p></template></details>
 <div class="flow-validation" role="alert" x-show="flowIssues.length" x-cloak><strong>Fix connections before saving</strong><template x-for="issue in flowIssues" :key="issue"><p x-text="issue"></p></template></div>
}

templ FlowCanvas() {
 <section class="canvas-section" x-show="mode === 'node'">
  <div class="canvas-toolbar"><div><span class="status-dot"></span><strong>Visual flow</strong><span class="text-slate-400" x-text="endpoint.flow.nodes.length + ' nodes'"></span><span class="first-match-note" x-show="branchModel">First match wins</span><span class="first-match-note" x-show="!branchModel">Legacy graph · connections preserved</span></div><div class="canvas-actions"><div class="canvas-zoom" role="group" aria-label="Canvas zoom"><button type="button" class="btn" aria-label="Zoom out" title="Zoom out (minimum 50%)" :disabled="zoom <= minZoom" @click="setZoom(zoom - zoomStep)">−</button><button type="button" class="btn zoom-reset" aria-label="Reset zoom to 100%" title="Reset zoom to 100%" @click="setZoom(1)" x-text="Math.round(zoom * 100) + '%' "></button><button type="button" class="btn" aria-label="Zoom in" title="Zoom in (maximum 200%)" :disabled="zoom >= maxZoom" @click="setZoom(zoom + zoomStep)">+</button></div><button x-show="canEditWorkspace" class="btn primary" @click="openAddScenario()">+ Add node</button></div></div>
  <div class="canvas-scroll"><div class="canvas-extent" :style="`width:${canvasWidth * zoom}px;height:${canvasHeight * zoom}px`"><div class="flow-canvas" :style="`width:${canvasWidth}px;height:${canvasHeight}px;transform:scale(${zoom})`" @pointermove.window="moveNode($event)" @pointerup.window="drag = null">
   <template x-for="edge in canvasEdges" :key="edge.from + ':' + (edge.branch || '')">
    <svg class="connections" :width="canvasWidth" :height="canvasHeight" aria-label="Flow connections">
     <defs><marker :id="'arrow-' + edge.from + '-' + (edge.branch || 'next')" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="none" stroke="currentColor"></path></marker></defs>
     <g class="connection-group" :role="canEditWorkspace ? 'button' : 'img'" :tabindex="canEditWorkspace ? 0 : -1" :aria-label="(canEditWorkspace ? 'Edit connection ' : 'Connection to ') + (endpoint.flow.nodes.find(node=>node.id===edge.to)?.label || '')" @click="canEditWorkspace && editConnection(edge)" @keydown.enter.prevent="canEditWorkspace && editConnection(edge)">
      <path class="connection-hit" :d="edgePath(edge)"></path><path class="connection-line" :d="edgePath(edge)" :class="edgeTraced(edge) && 'traced'" :marker-end="'url(#arrow-' + edge.from + '-' + (edge.branch || 'next') + ')'"></path><text :x="edgeMid(edge).x" :y="edgeMid(edge).y" x-text="edge.label || (edge.branch === 'true' ? 'Yes' : edge.branch === 'false' ? 'No' : '')"></text>
     </g>
    </svg>
   </template>
   <template x-for="node in endpoint.flow.nodes" :key="node.id">
    <article class="flow-node" :class="[node.type, node.id === highlightedNodeID && 'recent-node', trace.includes(node.id) && 'executed', connecting?.from === node.id && 'connecting']" :style="`left:${node.x}px;top:${node.y}px`">
     <div class="node-priority" x-show="branchModel && node.type === 'condition'"><span x-text="'Priority ' + priorityFor(node.id)"></span><button x-show="canEditWorkspace" type="button" aria-label="Increase condition priority" :disabled="priorityFor(node.id) === 1" @click="changePriority(node.id, priorityFor(node.id)-1)">↑</button><button x-show="canEditWorkspace" type="button" aria-label="Decrease condition priority" :disabled="priorityFor(node.id) === branchModel?.branches.length" @click="changePriority(node.id, priorityFor(node.id)+1)">↓</button></div><span class="node-default-tag" x-show="branchModel?.fallback.id === node.id">DEFAULT · LAST</span><div class="node-heading" @pointerdown="canEditWorkspace && startDrag($event, node)"><span class="node-icon" x-text="node.type === 'condition' ? conditionIcon(node.config) : nodeIcon(node.type)"></span><span x-text="node.label"></span><button x-show="canEditWorkspace" class="node-edit" @pointerdown.stop @click="editNodeScenario(node)" :aria-label="'Edit ' + node.label">Edit</button></div>
     <div class="node-content"><span class="node-type" x-text="node.type === 'condition' ? conditionMeta(node.config) : node.type"></span><code x-text="nodeSummary(node)"></code></div>
     <div class="node-actions"><button x-show="canEditWorkspace && node.type !== 'response'" @click="editNodeConnections(node)" x-text="branchModel ? (node.type === 'request' ? 'Default response ↗' : 'Response ↗') : 'Edit connection ↗'"></button><span x-show="node.type === 'response'">End of flow</span></div>
     <div class="node-ports" x-show="canEditWorkspace && !branchModel">
      <button x-show="canEditWorkspace && node.type !== 'request'" class="port-input" :class="connecting && 'available'" @click="connectTo(node)" :aria-label="'Connect to ' + node.label"><span class="port-label">Input</span></button>
      <template x-if="canEditWorkspace && node.type === 'condition'"><div><button class="port-output branch-true" @click="startConnection(node, 'true')" :aria-label="'Connect Yes branch from ' + node.label"><span class="port-label">Yes</span></button><button class="port-output branch-false" @click="startConnection(node, 'false')" :aria-label="'Connect No branch from ' + node.label"><span class="port-label">No</span></button></div></template>
      <button x-show="canEditWorkspace && !['condition','response'].includes(node.type)" class="port-output" @click="startConnection(node, '')" :aria-label="'Connect output from ' + node.label"><span class="port-label">Output</span></button>
     </div>
    </article>
   </template>
  </div></div></div>
  <div class="canvas-hint"><span x-text="!canEditWorkspace ? 'Read-only workspace · Zoom to explore the flow' : connecting ? 'Click the destination Input port. Press Escape to cancel.' : 'Drag nodes to arrange them · Click a line or Edit connection to change connections'"></span><span x-show="canEditWorkspace">Output port → Input</span></div>
 </section>
}

templ TableEditor() {
 <section class="flow-table-panel" x-show="mode === 'table'">
  <header class="flow-table-heading"><div class="scenario-heading-title"><h2 title="The first matching condition wins. Default response runs last.">Response scenarios</h2><span class="scenario-count" x-text="scenarioRows.length + (scenarioProjection.truncated ? '+' : '')" :aria-label="scenarioRows.length + ' response scenarios, including default'"></span></div><button x-show="canEditWorkspace" class="btn primary" @click="openAddScenario()">+ Add condition</button></header>
  <div class="table-overflow"><table class="scenario-table"><thead><tr><th>PRIORITY</th><th>REQUEST PATH</th><th>CONDITIONS</th><th>RESPONSE</th><th>HEADERS</th><th>ACTION</th></tr></thead><tbody>
   <template x-for="row in scenarioRows" :key="row.key"><tr><td><div class="table-priority"><span class="scenario-order" x-text="branchModel && row.isDefault ? '—' : row.order"></span><div x-show="branchModel && !row.isDefault"><button x-show="canEditWorkspace" aria-label="Increase condition priority" :disabled="row.order === 1" @click="changePriority(row.conditions[0]?.id,row.order-1)">↑</button><button x-show="canEditWorkspace" aria-label="Decrease condition priority" :disabled="row.order === branchModel?.branches.length" @click="changePriority(row.conditions[0]?.id,row.order+1)">↓</button></div><span class="priority-fixed" x-show="branchModel && row.isDefault">Default</span></div></td><td><div class="scenario-request"><strong x-text="endpoint.name"></strong><code><span class="request-method" x-text="endpoint.method"></span> <span x-text="endpoint.path"></span></code></div></td><td><div class="table-conditions"><template x-for="condition in scenarioConditionDetails(row)" :key="condition.id"><div class="table-condition"><span class="condition-outcome" x-text="condition.matched ? 'Matches' : 'Does not match'"></span><span class="scenario-condition" x-text="condition.summary"></span></div></template><span class="scenario-condition" x-show="!row.conditions.length" x-text="row.isDefault && conditions.length ? 'When no condition matches' : 'All incoming requests · no conditions'"></span><span class="default-tag" x-show="row.isDefault">DEFAULT</span></div></td><td><span class="response-code" x-text="row.status"></span><span class="type-pill" x-show="endpoint.flow.nodes.find(node=>node.id===row.responseID)?.config.response_mode === 'dynamic'">Dynamic</span><code class="scenario-body-preview" x-text="row.body || '(empty body)'"></code></td><td><span class="header-count" x-text="scenarioHeaderCount(row) + ' headers'"></span></td><td><div class="table-row-actions"><button class="btn scenario-view" @click="viewScenario(row)" :aria-label="'View path ' + row.label">View</button><button x-show="canEditWorkspace" class="btn scenario-edit" @click="editScenario(row)" :aria-label="'Edit path ' + row.label">Edit ↗</button></div></td></tr></template>
  </tbody></table></div>
  <div class="config-empty" x-show="!scenarioRows.length">The flow is not connected to a response. Check connections in Node mode.</div><div class="flow-validation" x-show="scenarioProjection.truncated">The table displays up to 128 paths. Use Node mode to review more complex graphs.</div>
  <footer class="scenario-summary-footer"><span x-text="conditions.length + (conditions.length === 1 ? ' condition' : ' conditions')"></span><span>Default response runs last</span></footer>
 </section>
}

templ TestPanel() {
 <section class="test-panel"><div class="canvas-toolbar"><div><strong>Request playground</strong><span class="text-slate-400">Test your flow before saving</span></div><button class="btn" @click="testOpen = !testOpen" x-text="testOpen ? 'Close' : 'Open'"></button><button class="btn dark" :disabled="testing" @click="runTest()" x-text="testing ? 'Running…' : '▷ Run test'"></button></div><div class="test-grid" x-show="testOpen"><div><label>INPUT JSON <span class="text-slate-400">params · query · headers · body</span></label><textarea aria-label="Test request JSON" class="code-editor" x-model="testInput" spellcheck="false"></textarea></div><div><label>RESPONSE <span class="response-status" x-show="testResult" x-text="testResult?.status"></span></label><pre class="response-output" x-show="testResult" x-text="testResult ? formatValue(testResult.body) : ''"></pre><div class="condition-test-report" x-show="testResult" x-cloak><strong>Selected response: <span x-text="testResponseLabel"></span></strong><p x-show="branchModel" x-text="testConditionChecks.some(check=>check.evaluated &amp;&amp; check.matched) ? 'First matching condition selected the response.' : 'No condition matched. Default response selected.'"></p><template x-for="check in testConditionChecks" :key="check.id"><div class="condition-test-check"><strong x-text="(priorityFor(check.id) ? '#'+priorityFor(check.id)+' ' : '')+check.label"></strong><span class="type-pill" x-text="check.evaluated ? (check.matched ? 'Matched' : 'Not matched') : 'Not visited'"></span><p x-text="check.reason"></p><template x-for="(rule,index) in check.rules" :key="index"><small x-text="rule.field+' · '+rule.operator+(rule.required ? ' · required' : '')+' · '+(rule.matched ? 'pass' : 'fail')+(rule.exists ? '' : ' · missing')"></small></template></div></template></div><details x-show="testResult"><summary>Raw result and execution trace</summary><pre class="response-output" x-text="testResult ? JSON.stringify(testResult, null, 2) : '// The response will appear here'"></pre></details><p x-show="!testResult">Run a request to see its selected response and condition checks.</p></div></div></section>
}

templ Dialogs() {
 <div class="modal-backdrop" x-show="modal" x-cloak @click.self="modal = null" role="presentation">
  <section class="modal" :class="{'scenario-modal': modal === 'scenario', 'path-view-modal': modal === 'view', 'users-modal': modal === 'users'}" role="dialog" aria-modal="true" :aria-label="modalTitle" x-trap.noscroll="modal" @keydown.ctrl.enter.prevent="commitModal()">
   <header><div><span class="eyebrow">MOCKLAB BUILDER</span><h2 x-text="modalTitle"></h2></div><button @click="modal = null" aria-label="Close dialog">✕</button></header>
   <template x-if="modal === 'view' && preview"><div><div class="path-view-summary"><strong x-text="preview.name"></strong><code x-text="preview.method + ' ' + preview.path"></code><span class="default-tag" x-show="preview.isDefault">DEFAULT</span><span class="view-draft-note" x-show="dirty">Draft preview</span></div><p class="help">Read-only configuration preview. Request values are examples; no API request is executed.</p><div class="path-view-grid">
    <section class="path-view-column"><h3>Request</h3><label>Endpoint URL</label><code class="view-url" x-text="preview.url"></code><label>Path parameters</label><pre x-text="formatValue(preview.example.params || {})"></pre><label>Query parameters</label><pre x-text="formatValue(preview.example.query || {})"></pre><label>Request headers</label><pre x-text="formatValue(preview.example.headers || {})"></pre><label x-text="'Body · ' + (preview.example.body_mode || 'json')"></label><pre x-text="formatValue(preview.example.body_mode === 'form' ? preview.example.form || {} : preview.example.raw_body || preview.example.body || {})"></pre></section>
    <section class="path-view-column"><h3>Conditions</h3><p class="help" x-show="!preview.conditions.length" x-text="preview.isDefault && conditions.length ? 'When no condition matches' : 'All incoming requests · no conditions'"></p><template x-for="(condition,index) in preview.conditions" :key="index"><div class="view-condition"><strong x-text="condition.condition_type + ' · ' + (condition.match === 'any' ? 'OR' : 'AND')"></strong><span class="condition-outcome" x-text="condition.matched ? 'Matches' : 'Does not match'"></span><span class="help" x-show="condition.condition_type === 'body'" x-text="condition.body_mode + (condition.body_mode === 'raw' ? ' · ' + condition.raw_format : '')"></span><template x-for="(rule,ruleIndex) in condition.rules" :key="ruleIndex"><div class="view-rule"><code x-text="rule.field"></code><span x-text="rule.operator + (rule.required ? ' · Required' : '')"></span><pre x-show="!['exists','empty'].includes(rule.operator)" x-text="formatValue(rule.value)"></pre></div></template></div></template></section>
    <section class="path-view-column"><h3>Response headers</h3><label>Effective headers</label><pre x-text="formatValue(preview.headers)"></pre><p class="help">Includes header nodes along this path and the response node overrides.</p></section>
    <section class="path-view-column"><h3>Response body</h3><span class="type-pill" x-text="preview.responseMode === 'dynamic' ? 'Dynamic JSON template' : 'Static JSON'"></span><p class="help" x-show="preview.responseMode === 'dynamic'">Template only. Use Playground to see rendered values.</p><div class="view-response-meta"><span class="response-code" x-text="preview.status"></span><span x-text="preview.delay + ' ms delay'"></span></div><pre class="view-response-body" x-text="preview.body ? formatValue(preview.body) : '(empty body)'"></pre></section>
   </div><div class="scenario-popup-footer"><button type="button" class="btn" @click="modal=null">Close</button></div></div></template>
   <template x-if="modal === 'members'"><div><p class="help">Owners manage the workspace and members. Editors manage endpoints. Viewers can browse and test mocks. Administrators have recovery access to every workspace.</p><form @submit.prevent="saveMember()"><label>Existing account username<input x-model="memberForm.username" required placeholder="username"/></label><label>Workspace role<select x-model="memberForm.role"><option value="viewer">Viewer</option><option value="editor">Editor</option><option value="owner">Owner</option></select></label><button class="btn primary" :disabled="busy">Add or update member</button></form><div class="workspace-member-list"><template x-for="member in members" :key="member.user_id"><div class="workspace-member-row"><div><strong x-text="member.name"></strong><small x-text="'@'+member.username+(member.active?'':' · Inactive')"></small></div><select aria-label="Member role" :value="member.role" :disabled="busy" @change="saveMember(member.username,$event.target.value)"><option value="viewer">Viewer</option><option value="editor">Editor</option><option value="owner">Owner</option></select><button class="btn" :disabled="busy" @click="removeMember(member)">Remove</button></div></template></div></div></template>
   <template x-if="modal === 'workspace'"><form @submit.prevent="saveWorkspace()"><label>Workspace name<input x-model="workspaceForm.name" required placeholder="Demo Store"/></label><label>Slug / base path<input x-model="workspaceForm.slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="demo-store"/></label><p class="help">Mock URL: /public/<span x-text="workspaceForm.slug || 'workspace'"></span>/…</p><button class="btn primary w-full" :disabled="busy">Save workspace</button></form></template>
   <template x-if="modal === 'endpoint'"><form @submit.prevent="createEndpoint()"><label>Endpoint name<input x-model="endpointForm.name" required placeholder="Get product"/></label><label>HTTP method<select x-model="endpointForm.method"><template x-for="m in methods"><option x-text="m"></option></template></select></label><label>Path<input x-model="endpointForm.path" required placeholder="/products/:id"/></label><div class="new-endpoint-hint"><strong>✓ A default response is available</strong><p>Incoming request → Default response (HTTP 200). Add a condition template for another scenario; configure it through the row's Edit button.</p></div><button class="btn primary w-full" :disabled="busy">Create endpoint with response 200</button></form></template>
   <template x-if="modal === 'palette'"><div><p class="help">Choose a type to create a connected node with one required field and AND matching. Configure details later using Edit.</p><div class="palette-context" x-show="connecting"><span x-text="'Insert at output: ' + (endpoint.flow.nodes.find(node => node.id === connecting?.from)?.label || '') + (connecting?.branch ? ' · ' + connecting.branch : '')"></span></div><div class="condition-palette"><template x-for="kind in conditionKinds" :key="kind.key"><button type="button" @click="quickAddCondition(kind.key)" :disabled="!canAddCondition(kind.key)"><span class="palette-icon" x-text="kind.icon"></span><strong x-text="kind.name"></strong><p x-text="kind.description"></p><span class="palette-hint" x-text="canAddCondition(kind.key) ? (kind.key === 'body' ? 'Default: Raw JSON · Edit for Form/Text' : 'Create node now →') : 'The route has no :parameter'"></span></button></template></div></div></template>
   <template x-if="modal === 'scenario' && scenarioForm"><form class="scenario-form" @submit.prevent="saveScenario()">
    <p class="scenario-shared-note" x-show="!scenarioScope">Request settings apply to this endpoint. Changes to shared conditions or responses affect every related path. The active version is updated when you save the draft.</p>
    <nav x-show="!scenarioScope" class="scenario-tabs" aria-label="Flow configuration sections"><button type="button" :class="scenarioTab === 'request' && 'active'" @click="scenarioTab='request'">Request</button><button type="button" :class="scenarioTab === 'conditions' && 'active'" @click="scenarioTab='conditions'">Conditions</button><button type="button" :class="scenarioTab === 'response' && 'active'" @click="scenarioTab='response'">Response</button><button type="button" x-show="scenarioForm.fallback" :class="scenarioTab === 'fallback' && 'active'" @click="scenarioTab='fallback'">Default response</button><button type="button" :class="scenarioTab === 'advanced' && 'active'" @click="scenarioTab='advanced'">Advanced flow</button></nav>
    <section x-show="scenarioTab === 'request'">
     <label>Endpoint name<input x-model="scenarioForm.route.name"/></label><div class="insertion-controls"><label>Method<select x-model="scenarioForm.route.method"><template x-for="method in methods" :key="method"><option x-text="method"></option></template></select></label><label>Path<input x-model="scenarioForm.route.path" placeholder="/products/:id"/></label></div>
     <label>Path parameters (JSON string values)<textarea class="code-editor short" x-model="scenarioForm.params" spellcheck="false"></textarea></label><label>Query parameters (JSON arrays of strings)<textarea class="code-editor short" x-model="scenarioForm.query" spellcheck="false"></textarea></label>
     @ScenarioHeaders("scenarioForm.headers")
     <label>Request body example format<select x-model="scenarioForm.bodyMode"><option value="json">Raw JSON</option><option value="form">Form</option><option value="text">Raw Text</option></select></label><label x-show="scenarioForm.bodyMode === 'json'">JSON body example<textarea class="code-editor" x-model="scenarioForm.body" spellcheck="false"></textarea></label><label x-show="scenarioForm.bodyMode === 'form'">Form fields (JSON arrays of strings)<textarea class="code-editor" x-model="scenarioForm.form" spellcheck="false" placeholder='{"email":["demo@example.com"]}'></textarea></label><label x-show="scenarioForm.bodyMode === 'text'">Raw text example<textarea class="code-editor" x-model="scenarioForm.rawBody" spellcheck="false"></textarea></label><p class="help">Request examples are loaded into the playground. Conditions evaluate actual incoming API requests.</p>
    </section>
    <section x-show="scenarioTab === 'conditions'">
     <template x-if="scenarioIsNew"><div class="scenario-template-picker"><label>Condition template<select :value="scenarioTemplate" @change="chooseScenarioTemplate($event.target.value)"><template x-for="item in conditionTemplates" :key="item.key"><option :value="item.key" :disabled="item.key === 'path' && !availablePathFields.length" x-text="item.name"></option></template></select></label><p class="help" x-text="conditionTemplates.find(item => item.key === scenarioTemplate)?.description"></p><p class="help">Templates select the field source. Configure the response and fallback in their tabs. Changing the template resets this popup's draft.</p></div></template>
     <div class="default-rule-note" x-show="scenarioForm.isDefault">This is the default response, used when no conditions match. A direct response does not need conditions.</div>
     <div class="condition-warning" x-show="scenarioConditionWarnings.length"><template x-for="warning in scenarioConditionWarnings" :key="warning"><p x-text="warning"></p></template></div>
     <template x-for="condition in scenarioForm.conditions" :key="condition.id"><div class="scenario-condition-editor"><div class="condition-match-heading"><span class="type-pill" x-text="condition.matched ? 'Matching path' : 'Previous condition did not match'"></span><button type="button" class="text-button danger-text" x-show="condition.matched && !scenarioIsNew && !scenarioScope" @click="removeScenarioCondition(condition.id)">Delete condition</button></div><label>Condition node name<input x-model="condition.label"/></label><div class="insertion-controls"><label>Condition type<select :value="condition.config.condition_type" @change="changeConditionKind(condition,$event.target.value)"><template x-for="kind in conditionKinds" :key="kind.key"><option :value="kind.key" :selected="kind.key === condition.config.condition_type" :disabled="kind.key === 'path' && !availablePathFields.length" x-text="kind.name"></option></template></select></label><label>Matching<select x-model="condition.config.match"><option value="all">All fields match (AND)</option><option value="any">Any field matches (OR)</option></select></label></div>
      <template x-if="condition.config.condition_type === 'body'"><div class="insertion-controls"><label>Body mode<select x-model="condition.config.body_mode" @change="changeBodyMode(condition)"><option value="raw">Raw</option><option value="form">Form</option></select></label><label x-show="condition.config.body_mode === 'raw'">Raw format<select x-model="condition.config.raw_format" @change="changeBodyMode(condition)"><option value="json">JSON</option><option value="text">Text</option></select></label></div></template>
      <div class="field-section-heading"><strong x-text="condition.config.rules.length + ' fields in this node'"></strong><button type="button" class="text-button" :disabled="condition.config.rules.length >= 50" @click="addConditionField(condition)">+ Add field</button></div>
      <div class="condition-rules-scroll"><div class="condition-rules-head"><span>FIELD</span><span>OPERATOR</span><span>VALUE</span><span>REQUIRED</span><span></span></div><template x-for="(rule,index) in condition.config.rules" :key="index"><div class="condition-rule-row"><template x-if="condition.config.condition_type === 'path'"><select aria-label="Path parameter field" x-model="rule.field"><option value="">Select parameter</option><template x-for="field in availablePathFields" :key="field"><option :value="field" x-text="field"></option></template></select></template><template x-if="condition.config.condition_type !== 'path'"><input aria-label="Condition field" x-model="rule.field" :readonly="condition.config.condition_type === 'body' && condition.config.body_mode === 'raw' && condition.config.raw_format === 'text'" :placeholder="condition.config.condition_type === 'header' ? 'Authorization' : condition.config.condition_type === 'query' ? 'page' : 'user.email'"/></template><select aria-label="Condition operator" x-model="rule.operator"><option value="exists">Exists</option><option value="equals">Equals</option><option value="not_equals">Not equals</option><option value="contains">Contains</option><option value="empty">Empty / missing</option></select><input aria-label="Condition value" x-model="rule.value" :disabled="['exists','empty'].includes(rule.operator)" :placeholder="['exists','empty'].includes(rule.operator) ? 'Not needed' : 'Comparison value'"/><label class="required-check"><input type="checkbox" x-model="rule.required" aria-label="Field must not be empty"/><span>Required</span></label><button type="button" @click="condition.config.rules.splice(index,1)" :disabled="condition.config.rules.length === 1" aria-label="Delete condition field">✕</button></div></template></div>
      <p class="help">Required: the field must be present and nonempty for this rule to match. Null, whitespace, and empty objects/arrays are rejected; 0 and false remain valid. Exists without Required only checks presence. OR matches when any rule is satisfied.</p>
     </div></template>
     <p class="help" x-show="!scenarioForm.conditions.length">Incoming requests go directly to the default response. Use Add condition if another scenario is needed.</p>
    </section>
    <template x-if="scenarioForm.response"><section x-show="scenarioTab === 'response'">@ScenarioResponse("response", "Response for this path")</section></template>
    <template x-if="scenarioForm.fallback"><section x-show="scenarioTab === 'fallback'"><p class="default-rule-note">The default response applies when no conditions match. Changes update this endpoint's fallback.</p>@ScenarioResponse("fallback", "Default response")</section></template>
    <section x-show="scenarioTab === 'advanced'">
     <div class="scenario-advanced-note" x-show="!scenarioScope && !branchModel">Existing graph settings are preserved. Change destinations as needed; all nodes must stay connected and the graph must have no cycles.</div>
     <template x-for="edge in scenarioForm.connections" :key="edge.from + ':' + (edge.branch || '')"><label><span x-text="scenarioDraft.nodes.find(node => node.id === edge.from)?.label + (edge.branch ? ' · ' + (edge.branch === 'true' ? 'match' : 'no match') : '')"></span><select x-model="edge.to"><template x-for="target in scenarioDraft.nodes.filter(node => node.type !== 'request' && node.id !== edge.from && (!branchModel || node.type === 'response'))" :key="target.id"><option :value="target.id" x-text="target.label"></option></template></select></label></template>
     <template x-for="block in scenarioForm.legacyHeaders" :key="block.id"><div class="scenario-condition-editor"><strong x-text="block.label"></strong>@ScenarioHeaders("block.headers")</div></template>
     <template x-for="block in scenarioForm.legacyDelays" :key="block.id"><label><span x-text="block.label + ' (ms)'"></span><input type="number" min="0" max="10000" x-model.number="block.delay_ms"/></label></template>
    </section>
    <div class="scenario-popup-footer"><button type="button" class="btn" @click="modal=null">Cancel</button><button class="btn primary" x-text="scenarioScope ? 'Apply node to draft' : scenarioIsNew ? 'Add condition to draft' : 'Apply all to draft'"></button></div>
   </form></template>
   <template x-if="modal === 'connection' && !branchModel"><form @submit.prevent="saveConnection()"><label>From step<select x-model="connectionForm.from" @change="connectionSourceChanged()"><template x-for="source in insertionSources" :key="source.id"><option :value="source.id" x-text="source.label"></option></template></select></label><label>Branch<select x-model="connectionForm.branch" @change="connectionBranchChanged()"><template x-for="branch in branchesFor(connectionForm.from)" :key="branch"><option :value="branch" x-text="branch === 'true' ? 'Yes / match' : branch === 'false' ? 'No / fallback' : 'Next'"></option></template></select></label><label>To step<select x-model="connectionForm.to"><option value="">Not connected</option><template x-for="target in orderedNodes.filter(node => node.id !== connectionForm.from && node.type !== 'request')" :key="target.id"><option :value="target.id" x-text="target.label"></option></template></select></label><p class="help">One destination per branch. Cycles are rejected. Connect every branch before saving the endpoint.</p><div class="modal-actions"><button type="button" class="btn danger-quiet" x-show="originalConnection" @click="removeConnection()">Delete connection</button><button class="btn primary">Save connection</button></div></form></template>
   <template x-if="modal === 'connection' && branchModel"><form @submit.prevent="saveConnection()"><p class="help" x-text="connectionForm.branch === 'default' ? 'Used only when no condition matches. Default always runs last.' : 'Used when this condition matches. A failed condition continues to the next priority.'"></p><label>Response<select x-model="connectionForm.to"><template x-for="response in responses" :key="response.id"><option :value="response.id" x-text="response.label + ' · ' + response.config.status"></option></template></select></label><p class="help">An unused response is removed from the draft when its last connection is replaced. You can undo the change.</p><button class="btn primary">Apply connection to draft</button></form></template>
   @IdentityDialogs()
   <p class="dialog-error" role="alert" x-show="dialogError" x-text="dialogError"></p>
  </section>
 </div>
}


templ ScenarioHeaders(binding string) {
 <div class="header-fields"><div class="field-section-heading"><strong>Headers</strong><button type="button" class="text-button" @click={ binding + ".push({key:'',value:''})" }>+ Header</button></div><template x-for={ "(header, index) in " + binding } :key="index"><div class="header-field-row"><input aria-label="Header key" placeholder="Content-Type" x-model="header.key"/><input aria-label="Header value" placeholder="application/json" x-model="header.value"/><button type="button" @click={ binding + ".splice(index,1)" } aria-label="Delete header">✕</button></div></template></div>
}

templ ScenarioResponse(section string, title string) {
 <div class="scenario-response-fields"><h3>{ title }</h3><label>Response template<select :value={ "scenarioForm." + section + ".template" } @change={ "selectScenarioResponseTemplate('" + section + "', $event.target.value)" }><option value="keep">Keep / custom</option><template x-for="item in responseTemplates" :key="item.key"><option :value="item.key" x-text="item.name"></option></template></select></label><label>Response name<input x-model={ "scenarioForm." + section + ".label" }/></label>
  <label>Response mode<select aria-label="Response mode" x-model={ "scenarioForm." + section + ".response_mode" }><option value="static">Static JSON</option><option value="dynamic">Dynamic JSON</option></select></label>
  <p class="help" x-show={ "scenarioForm." + section + ".response_mode === 'static'" }>Static JSON is sent exactly as written. Template expressions remain literal text.</p>
  <div class="dynamic-response-tools" x-show={ "scenarioForm." + section + ".response_mode === 'dynamic'" }>
   <p class="help">A variable used as the whole JSON value preserves its type. Variables inside a sentence become text. Missing fields need a default. Header values always become text.</p>
   <label>Generator seed (optional)<input x-model={ "scenarioForm." + section + ".response_seed" } maxlength="256" placeholder="Leave empty for new random values"/></label><p class="help">A fixed seed repeats generated UUIDs, integers and choices. Timestamp always uses the current time. The same generator expression is reused within one response, including its headers.</p>
   <a class="text-button" href="/docs/generators" target="_blank" rel="noopener">Generator reference ↗</a>
   <button class="btn" type="button" @click={ "openResponseVariables('" + section + "')" }>Insert variable</button>
   <div class="response-variable-picker" x-show={ "variablePicker === '" + section + "'" }>
    <label>Source<select x-model="responseVariable.source"><option value="request.path">Path parameter</option><option value="request.query">Query parameter</option><option value="request.headers">Request header</option><option value="request.body">JSON body field</option><option value="request.form">Form body field</option><option value="request.raw_body">Raw request body</option><option value="generate.uuid">Generated UUID</option><option value="generate.timestamp">Current timestamp</option><option value="generate.integer">Random integer</option><option value="generate.choice">Random choice</option></select></label>
    <label x-show="['request.path','request.query','request.headers','request.body','request.form'].includes(responseVariable.source)">Source field<input x-model="responseVariable.field" placeholder="name or user.name"/></label>
    <label x-show="['generate.integer','generate.choice'].includes(responseVariable.source)">Generator arguments (JSON array)<input x-model="responseVariable.arguments" placeholder='[1, 100] or ["pending", "paid"]'/></label>
    <div x-show="responseVariable.source.startsWith('request.')"><label class="required-check"><input type="checkbox" x-model="responseVariable.hasDefault"/> Use default when missing</label><label x-show="responseVariable.hasDefault">Default value (JSON)<input x-model="responseVariable.defaultJSON" placeholder='"Guest", 0, false, null, [], {}'/></label></div>
    <label>Destination<select x-model="responseVariable.target"><option value="body">JSON body field</option><option value="headers">Response header</option></select></label><label>Response field / header name<input x-model="responseVariable.key" placeholder="value or X-Request-ID"/></label><button type="button" class="btn primary" @click={ "insertResponseVariable('" + section + "')" }>Insert into response</button>
   </div>
  </div>
  <div class="insertion-controls"><label>HTTP status<input type="number" min="200" max="599" x-model.number={ "scenarioForm." + section + ".status" }/></label><label>Response delay (ms)<input type="number" min="0" max="10000" x-model.number={ "scenarioForm." + section + ".delay_ms" }/></label></div>@ScenarioHeaders("scenarioForm." + section + ".headers")<label>JSON body<textarea aria-label="Response JSON body" class="code-editor" x-model={ "scenarioForm." + section + ".body" } spellcheck="false"></textarea></label>
  <button type="button" class="btn" :disabled={ "scenarioForm." + section + ".previewBusy" } @click={ "previewResponse('" + section + "')" }>Preview rendered response</button><p class="help">Uses the current Playground input and this response only. Does not apply changes to the draft. Re-run after editing.</p>
  <p class="dialog-error" role="alert" x-show={ "scenarioForm." + section + ".previewError" } x-text={ "scenarioForm." + section + ".previewError" }></p>
  <template x-if={ "scenarioForm." + section + ".previewResult" }><div class="response-render-preview"><strong>Last preview</strong><pre class="response-output" x-text={ "formatValue(scenarioForm." + section + ".previewResult.body)" }></pre><label>Rendered headers</label><pre x-text={ "formatValue(scenarioForm." + section + ".previewResult.headers)" }></pre></div></template>
 </div>
}
